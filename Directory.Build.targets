<Project>

  <!--
    Bundle the shared icon into every package. Imported after each project file, so
    $(IsPackable) already reflects the per-library opt-in and non-packable projects are skipped.
    Each library ships its own README.md (packed from its own .csproj), so no readme is added here.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
