<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:nav="clr-namespace:Joufflu.Navigation.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:MaxCornerRadiusConverter x:Key="MaxCornerRadiusConverter" />

    <!--
        An entry of the menu: a ghost action (hover and focus from the Button style) without the pressed
        translation, the menu being a display and its entries the items of it.
    -->
    <Style
        x:Key="NavigationEntryButton"
        BasedOn="{StaticResource GhostButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Tag="{DynamicResource {x:Static joufflu:Dimensions.ActionRadius}}">
                        <Border.CornerRadius>
                            <MultiBinding Converter="{StaticResource MaxCornerRadiusConverter}">
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </Border.CornerRadius>
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================ NavigationItem ============================  -->
    <Style TargetType="{x:Type nav:NavigationItem}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
        <!--  No font size of its own: the entry button carries the one of its size.  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nav:NavigationItem}">
                    <Button
                        x:Name="ItemButton"
                        Height="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type nav:NavigationMenu}}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource NavigationEntryButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                x:Name="IconPresenter"
                                Grid.Column="0"
                                Content="{TemplateBinding Icon}" />

                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <!--  Recolors custom content, which inherits Foreground from the NavigationItem (not the ItemButton)  -->
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryContentBrush}}" />
                            <Setter TargetName="ItemButton" Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                            <!--  The icon inherits from the ItemButton, so it needs its own override  -->
                            <Setter TargetName="ItemButton" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryContentBrush}}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type nav:NavigationMenu}}}" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ItemButton" Property="Width" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}" />
                            <Setter TargetName="ItemButton" Property="HorizontalContentAlignment" Value="Center" />
                            <Setter TargetName="ItemButton" Property="Padding" Value="0" />
                            <!--  Collapsed: the label is hidden, so surface it as a tooltip beside the icon  -->
                            <Setter TargetName="ItemButton" Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ItemButton" Property="toolkit:ThemedTooltip.Placement" Value="Right" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================ NavigationGroup ============================  -->
    <Style TargetType="{x:Type nav:NavigationGroup}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nav:NavigationGroup}">
                    <StackPanel>
                        <Button
                            x:Name="HeaderButton"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding ToggleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource NavigationEntryButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="IconPresenter"
                                    Grid.Column="0"
                                    Content="{TemplateBinding Icon}" />

                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ContentSource="Header" />

                                <fonts:FontIcon
                                    x:Name="Chevron"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="{x:Static fonts:LucideFontIcons.ChevronDown}" />
                            </Grid>
                        </Button>

                        <Border
                            x:Name="ChildrenHost"
                            Margin="16,0,0,0"
                            Padding="8,0,0,0"
                            toolkit:Derive.BorderThickness="{x:Static joufflu:Dimensions.DisplayBorderThickness}"
                            toolkit:Derive.BorderThicknessFactor="1,0,0,0"
                            BorderBrush="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}"
                            Visibility="Collapsed">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ChildrenHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="Text" Value="{x:Static fonts:LucideFontIcons.ChevronUp}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type nav:NavigationMenu}}}" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChildrenHost" Property="Margin" Value="0" />
                            <Setter TargetName="ChildrenHost" Property="Padding" Value="0" />
                            <Setter TargetName="ChildrenHost" Property="toolkit:Derive.BorderThicknessFactor" Value="0" />
                            <!--  Collapsed: no indent to show nesting, so shade the children to keep them visually grouped  -->
                            <Setter TargetName="ChildrenHost" Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.DisplaySurface2Brush}}" />
                            <Setter TargetName="ChildrenHost" Property="CornerRadius" Value="{DynamicResource {x:Static joufflu:Dimensions.DisplayCornerRadius}}" />
                            <Setter TargetName="HeaderButton" Property="Width" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}" />
                            <Setter TargetName="HeaderButton" Property="HorizontalContentAlignment" Value="Center" />
                            <Setter TargetName="HeaderButton" Property="Padding" Value="0" />
                            <!--  Collapsed: the header is hidden, so surface it as a tooltip beside the icon  -->
                            <Setter TargetName="HeaderButton" Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="HeaderButton" Property="toolkit:ThemedTooltip.Placement" Value="Right" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================ NavigationTitle ============================  -->
    <Style TargetType="{x:Type nav:NavigationTitle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nav:NavigationTitle}">
                    <Grid Margin="0,12,0,4">
                        <ContentPresenter
                            x:Name="TitleText"
                            TextBlock.FontSize="{DynamicResource {x:Static joufflu:Dimensions.FontSizeXs}}"
                            Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}" />

                        <Border
                            x:Name="TitleLine"
                            VerticalAlignment="Center"
                            toolkit:Derive.BorderThickness="{x:Static joufflu:Dimensions.DisplayBorderThickness}"
                            toolkit:Derive.BorderThicknessFactor="0,1,0,0"
                            BorderBrush="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type nav:NavigationMenu}}}" Value="True">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleLine" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================ NavigationMenu ============================  -->
    <Style TargetType="{x:Type nav:NavigationMenu}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.DisplaySurface1Brush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}" />
        <!--  Right edge only: the menu just separates itself from the content beside it.  -->
        <Setter Property="toolkit:Derive.BorderThickness" Value="{x:Static joufflu:Dimensions.DisplayBorderThickness}" />
        <Setter Property="toolkit:Derive.BorderThicknessFactor" Value="0,0,1,0" />
        <Setter Property="Width" Value="220" />
        <!--  A compact display: the header and the items sit at this inset from the menu edges.  -->
        <Setter Property="Padding" Value="{DynamicResource {x:Static joufflu:Dimensions.DisplayPaddingSm}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nav:NavigationMenu}">
                    <Grid>
                        <!--
                            Paints the menu without taking part in hit testing, so the header strip
                            lets the window be grabbed when under a ThemedWindow title bar.
                        -->
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            IsHitTestVisible="False" />

                        <DockPanel Margin="{TemplateBinding Padding}">
                            <!--  No background: the header and the free space around the collapse button drag the window.  -->
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="HeaderPresenter"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    toolkit:Derive.Margin="{x:Static joufflu:Dimensions.ActionPaddingMd}"
                                    toolkit:Derive.MarginFactor="1,0,0,0"
                                    Content="{TemplateBinding Header}"
                                    IsHitTestVisible="False" />

                                <Button
                                    x:Name="CollapseButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    toolkit:Sizing.IsSquare="True"
                                    toolkit:Sizing.Size="sm"
                                    Command="{Binding ToggleCollapseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource GhostButton}">
                                    <fonts:FontIcon x:Name="CollapseIcon" Text="{x:Static fonts:LucideFontIcons.PanelLeftClose}" />
                                </Button>
                            </Grid>

                            <!--  The items area blocks the drag: only the header strip moves the window.  -->
                            <ScrollViewer
                                Background="Transparent"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCollapsed" Value="True">
                            <Setter Property="Width" Value="auto" />
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CollapseButton" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="CollapseIcon" Property="Text" Value="{x:Static fonts:LucideFontIcons.PanelLeftOpen}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
