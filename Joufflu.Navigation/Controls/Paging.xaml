<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Navigation.Controls"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/ToggleButton.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:MaxCornerRadiusConverter x:Key="MaxCornerRadiusConverter" />

    <!--
        A page of the bar: a ghost action (hover, focus and the primary when current from the ToggleButton style)
        without the pressed translation, the pages being the items of the bar.
    -->
    <Style
        x:Key="PagingPageButton"
        BasedOn="{StaticResource GhostToggleButton}"
        TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Tag="{DynamicResource {x:Static joufflu:Dimensions.ActionRadius}}">
                        <Border.CornerRadius>
                            <MultiBinding Converter="{StaticResource MaxCornerRadiusConverter}">
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </Border.CornerRadius>
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Paging}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Paging}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Clipped to its column: short of room, the pages are cut at the edge rather than drawn over the interval  -->
                        <StackPanel
                            Grid.Column="0"
                            ClipToBounds="True"
                            Orientation="Horizontal">

                            <Button
                                toolkit:Sizing.IsSquare="True"
                                Command="{Binding PreviousCommand}"
                                Style="{StaticResource GhostButton}">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ChevronLeft}" />
                            </Button>

                            <ItemsControl ItemsSource="{Binding AvailablePages}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailablePages.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type local:PagingSelectionSeparator}">
                                        <Button
                                            Margin="2,0,0,0"
                                            toolkit:Sizing.IsSquare="True"
                                            Content="..."
                                            IsEnabled="False"
                                            Style="{StaticResource GhostButton}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type local:PagingSelectionItem}">
                                        <ToggleButton
                                            Margin="2,0,0,0"
                                            toolkit:Sizing.IsSquare="True"
                                            Command="{Binding GoToCommand, RelativeSource={RelativeSource AncestorType={x:Type local:Paging}}}"
                                            CommandParameter="{Binding Target}"
                                            Content="{Binding Target}"
                                            IsChecked="{Binding IsActive, Mode=OneWay}"
                                            Style="{StaticResource PagingPageButton}" />
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <Button
                                Margin="2,0,0,0"
                                toolkit:Sizing.IsSquare="True"
                                Command="{Binding NextCommand}"
                                Style="{StaticResource GhostButton}">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ChevronRight}" />
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            toolkit:Spacing.Gap="8"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotalKnown}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}-{1} of {2}">
                                        <Binding Path="IntervalMin" />
                                        <Binding Path="IntervalMax" />
                                        <Binding Path="Total" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <ComboBox
                                ItemStringFormat="{}{0} / page"
                                ItemsSource="{Binding AvailableCapacities}"
                                SelectedItem="{Binding Capacity}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
