<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:nav="clr-namespace:Joufflu.Navigation.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="OverlayTemplate" DataType="{x:Type nav:OverlayInstance}">
        <Grid>
            <Border Background="#000000" Opacity="0.5">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding ClickAwayCommand}" MouseAction="LeftClick" />
                </Border.InputBindings>
            </Border>

            <Border
                x:Name="Panel"
                MinWidth="320"
                MaxWidth="640"
                MaxHeight="600"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource {x:Static joufflu:Brushes.BackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}"
                BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}"
                CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                <Grid Margin="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="Header">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource H4}"
                            Text="{Binding Options.Title}" />

                        <Button
                            x:Name="CloseButton"
                            Grid.Column="1"
                            Padding="0"
                            joufflu:Sizing.IsSquare="True"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource GhostButton}">
                            <fonts:FontIcon FontSize="16" Text="{x:Static fonts:LucideFontIcons.x}" />
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ContentPresenter Content="{Binding Content}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DataTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Options.Title}" Value="" />
                    <Condition Binding="{Binding Options.ShowCloseButton}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Options.ShowCloseButton}" Value="False">
                <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Options.FullScreen}" Value="True">
                <Setter TargetName="Panel" Property="MaxWidth" Value="Infinity" />
                <Setter TargetName="Panel" Property="MaxHeight" Value="Infinity" />
                <Setter TargetName="Panel" Property="Margin" Value="0" />
                <Setter TargetName="Panel" Property="HorizontalAlignment" Value="Stretch" />
                <Setter TargetName="Panel" Property="VerticalAlignment" Value="Stretch" />
                <Setter TargetName="Panel" Property="BorderThickness" Value="0" />
                <Setter TargetName="Panel" Property="CornerRadius" Value="0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
