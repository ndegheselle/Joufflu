<UserControl
    x:Class="Joufflu.Data.Controls.DataEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:jata="clr-namespace:Joufflu.Data.Controls"
    xmlns:jodels="clr-namespace:Joufflu.Data.Model"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Data.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    d:DataContext="{d:DesignInstance Type=local:DataEdit}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataDisplay/TreeView.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                One editor per shape a DataValue can take. They are picked by
                DataValueEditorSelector below, and they all edit the same DataValue.Value; the
                size comes from the hosting ContentControl, since Sizing.Size is inherited.
            -->
            <DataTemplate x:Key="StringEditor">
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>

            <DataTemplate x:Key="IntegerEditor">
                <inputs:NumericUpDown Value="{Binding Value}" />
            </DataTemplate>

            <DataTemplate x:Key="NumberEditor">
                <inputs:DecimalUpDown Value="{Binding Value}" />
            </DataTemplate>

            <DataTemplate x:Key="BooleanEditor">
                <CheckBox
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Value}" />
            </DataTemplate>

            <DataTemplate x:Key="EnumerationEditor">
                <ComboBox
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Options}"
                    SelectedValue="{Binding Value}"
                    SelectedValuePath="Value" />
            </DataTemplate>

            <DataTemplate x:Key="DateEditor">
                <DatePicker SelectedDate="{Binding Value}" />
            </DataTemplate>

            <DataTemplate x:Key="TimeEditor">
                <inputs:TimeSpanPicker Value="{Binding Value}" />
            </DataTemplate>

            <!--
                Manual mode: the value is picked from a closed list instead of being filled in, so
                a field can be forced to nothing or to one of the host's entries (a reference, say)
                whatever its own type calls for.
            -->
            <jata:DataManualValuesConverter x:Key="ManualValuesConverter" />

            <DataTemplate x:Key="ManualEditor">
                <!--
                    The entries are searched by typing, since a host's catalog of references is
                    not something to scroll through. DisplayMemberPath is left unset on purpose:
                    it and ItemTemplate cannot both be set, and the search falls back to the
                    entry's ToString, which is its display name.
                -->
                <inputs:ComboBoxSearch SelectedItem="{Binding ManualEntry}">
                    <inputs:ComboBoxSearch.ItemsSource>
                        <MultiBinding Converter="{StaticResource ManualValuesConverter}">
                            <Binding />
                            <Binding Path="ManualValues" RelativeSource="{RelativeSource AncestorType={x:Type local:DataEdit}}" />
                        </MultiBinding>
                    </inputs:ComboBoxSearch.ItemsSource>
                    <inputs:ComboBoxSearch.ItemTemplate>
                        <DataTemplate>
                            <StackPanel toolkit:Spacing.Gap="4" Orientation="Horizontal">
                                <jata:DataIcon Type="{Binding Type}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </inputs:ComboBoxSearch.ItemTemplate>
                </inputs:ComboBoxSearch>
            </DataTemplate>

            <!--
                ContentTemplate wins over ContentTemplateSelector, so setting it on IsManual swaps
                the schema's editor out for the manual list and clearing it brings the editor back.
            -->
            <Style x:Key="DataValueEditorHost" TargetType="ContentControl">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                        <Setter Property="ContentTemplate" Value="{StaticResource ManualEditor}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <jata:DataValueTemplateSelector
                x:Key="DataValueEditorSelector"
                BooleanTemplate="{StaticResource BooleanEditor}"
                DateTemplate="{StaticResource DateEditor}"
                EnumerationTemplate="{StaticResource EnumerationEditor}"
                FallbackTemplate="{StaticResource StringEditor}"
                IntegerTemplate="{StaticResource IntegerEditor}"
                NumberTemplate="{StaticResource NumberEditor}"
                StringTemplate="{StaticResource StringEditor}"
                TimeTemplate="{StaticResource TimeEditor}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TreeView ItemsSource="{Binding Node.Properties}">
            <TreeView.ItemContainerStyle>
                <Style BasedOn="{StaticResource TreeViewItemStyle}" TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type jodels:DataArray}" ItemsSource="{Binding Items}">
                    <StackPanel toolkit:Spacing.Gap="4" Orientation="Horizontal">
                        <jata:DataIcon Type="{Binding Type}" />
                        <TextBlock Text="{Binding Key}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
                <HierarchicalDataTemplate DataType="{x:Type jodels:DataObject}" ItemsSource="{Binding Properties}">
                    <StackPanel toolkit:Spacing.Gap="4" Orientation="Horizontal">
                        <jata:DataIcon Type="{Binding Type}" />
                        <TextBlock Text="{Binding Key}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type jodels:DataArrayControl}">
                    <Button
                        HorizontalAlignment="Left"
                        toolkit:Sizing.Size="xs"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource GhostButton}">
                        <StackPanel toolkit:Spacing.Gap="2" Orientation="Horizontal">
                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Plus}" />
                            <TextBlock VerticalAlignment="Center">Add</TextBlock>
                        </StackPanel>
                    </Button>
                </DataTemplate>
                <DataTemplate DataType="{x:Type jodels:DataValue}">
                    <Grid VerticalAlignment="Center" toolkit:Spacing.Gap="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <jata:DataIcon Type="{Binding Type}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Key}" />
                        <ContentControl
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            toolkit:Sizing.Size="sm"
                            Content="{Binding}"
                            ContentTemplateSelector="{StaticResource DataValueEditorSelector}"
                            Style="{StaticResource DataValueEditorHost}" />
                        <ToggleButton
                            Grid.Column="3"
                            toolkit:Sizing.IsSquare="True"
                            toolkit:Sizing.Size="sm"
                            toolkit:Tooltip.Content="Force the value"
                            IsChecked="{Binding IsManual}"
                            Style="{StaticResource ToggleGhost}">
                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Variable}" />
                        </ToggleButton>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
        <Button Grid.Row="1" Command="{Binding TestCommand}">Test</Button>
    </Grid>
</UserControl>
