<UserControl
    x:Class="Joufflu.Data.Controls.DataDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jata="clr-namespace:Joufflu.Data.Controls"
    xmlns:jodels="clr-namespace:Joufflu.Data.Model"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Data.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    d:DataContext="{d:DesignInstance Type=local:DataDisplay}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataDisplay/TreeView.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Joufflu.Data;component/Controls/DataResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Header of a node: its key and its type  -->
            <DataTemplate x:Key="DataNodeHeader">
                <Grid toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <jata:DataIcon Type="{Binding Type}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="{Binding Key}"
                        TextTrimming="CharacterEllipsis" />
                    <jonts:FontIcon
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        toolkit:Tooltip.Content="{Binding Description}"
                        Foreground="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}"
                        Text="{x:Static jonts:LucideFontIcons.Info}"
                        Visibility="{Binding Description, Converter={x:Static converters:VisibilityConverter.Default}}" />
                </Grid>
            </DataTemplate>

            <!--  Undefined and null are no value: they read apart from a text saying "null".  -->
            <Style x:Key="DataManualText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ManualValue}" Value="{x:Null}">
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.Foreground200Brush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ManualValue.Value}" Value="{x:Null}">
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.Foreground200Brush}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  Row of an object or an array: in manual mode, the manual value stands for its children, which are left out.  -->
            <DataTemplate x:Key="DataParentRow">
                <Grid
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DataNodeHeader}" />
                    <jonts:FontIcon
                        Grid.Column="1"
                        toolkit:Tooltip.Content="Manual value"
                        Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground200Brush}}"
                        Text="{x:Static jonts:LucideFontIcons.Feather}"
                        Visibility="{Binding IsManual, Converter={x:Static converters:VisibilityConverter.Default}}" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource DataManualText}"
                        Visibility="{Binding IsManual, Converter={x:Static converters:VisibilityConverter.Default}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ValueTextConverter}">
                                <Binding />
                                <Binding Path="IsManual" />
                                <Binding Path="ManualValue" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <TreeView ItemsSource="{Binding Node.Properties}">
        <TreeView.ItemContainerStyle>
            <Style BasedOn="{StaticResource TreeViewItemStyle}" TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type jodels:DataArray}">
                <HierarchicalDataTemplate.ItemsSource>
                    <MultiBinding Converter="{StaticResource ChildrenConverter}">
                        <Binding />
                        <Binding Path="IsManual" />
                    </MultiBinding>
                </HierarchicalDataTemplate.ItemsSource>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DataParentRow}" />
            </HierarchicalDataTemplate>
            <HierarchicalDataTemplate DataType="{x:Type jodels:DataObject}">
                <HierarchicalDataTemplate.ItemsSource>
                    <MultiBinding Converter="{StaticResource ChildrenConverter}">
                        <Binding />
                        <Binding Path="IsManual" />
                    </MultiBinding>
                </HierarchicalDataTemplate.ItemsSource>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DataParentRow}" />
            </HierarchicalDataTemplate>
            <DataTemplate DataType="{x:Type jodels:DataValue}">
                <Grid
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DataNodeHeader}" />
                    <!--  A manual value is flagged the way the toggle setting it reads.  -->
                    <jonts:FontIcon
                        Grid.Column="1"
                        toolkit:Tooltip.Content="Manual value"
                        Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground200Brush}}"
                        Text="{x:Static jonts:LucideFontIcons.Feather}"
                        Visibility="{Binding IsManual, Converter={x:Static converters:VisibilityConverter.Default}}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ValueTextConverter}">
                                <Binding />
                                <Binding Path="Value" />
                                <Binding Path="IsManual" />
                                <Binding Path="ManualValue" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!--  Null and undefined are no value: they read apart from a text saying "null".  -->
                                    <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                        <Setter Property="FontStyle" Value="Italic" />
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.Foreground200Brush}}" />
                                    </DataTrigger>
                                    <!--  Set manually to nothing yet, which writes nothing: read as undefined.  -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsManual}" Value="True" />
                                            <Condition Binding="{Binding ManualValue}" Value="{x:Null}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="FontStyle" Value="Italic" />
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.Foreground200Brush}}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </TreeView.Resources>
    </TreeView>
</UserControl>
