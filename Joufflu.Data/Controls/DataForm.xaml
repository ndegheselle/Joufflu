<local:DataControlBase
    x:Class="Joufflu.Data.Controls.DataForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Data.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jata="clr-namespace:Joufflu.Data.Controls"
    xmlns:jnputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:jodels="clr-namespace:Joufflu.Data.Model"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Data.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    d:DataContext="{d:DesignInstance Type=local:DataForm}"
    mc:Ignorable="d">
    <local:DataControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Joufflu.Data;component/Controls/DataResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:DataFileOptionsConverter x:Key="FileOptionsConverter" />
            <converters:DataManualToggleVisibilityConverter x:Key="ManualToggleVisibilityConverter" />
            <converters:DataArrayValuesConverter x:Key="ArrayValuesConverter" />
            <Thickness x:Key="ItemsSpacing">0,0,0,4</Thickness>

            <!--#region Editors : the ones of DataResources, and the inputs the schema asks for-->
            <DataTemplate x:Key="MultilineEditor">
                <TextBox
                    Height="auto"
                    MinHeight="72"
                    VerticalContentAlignment="Top"
                    AcceptsReturn="True"
                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </DataTemplate>

            <DataTemplate x:Key="FileEditor">
                <jnputs:FilePicker FilePath="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Options="{Binding FileFilter, Converter={StaticResource FileOptionsConverter}}" />
            </DataTemplate>

            <jata:DataValueTemplateSelector
                x:Key="FormEditorSelector"
                BooleanTemplate="{StaticResource BooleanEditor}"
                DateTemplate="{StaticResource DateEditor}"
                EnumerationTemplate="{StaticResource EnumerationEditor}"
                FallbackTemplate="{StaticResource StringEditor}"
                FileTemplate="{StaticResource FileEditor}"
                IntegerTemplate="{StaticResource IntegerEditor}"
                MultilineTemplate="{StaticResource MultilineEditor}"
                NumberTemplate="{StaticResource NumberEditor}"
                StringTemplate="{StaticResource StringEditor}"
                TimeTemplate="{StaticResource TimeEditor}" />
            <!--#endregion-->

            <!--  The editor of a value, swapped for the list of manual values while it is forced.  -->
            <Style x:Key="FormEditorHost" TargetType="ContentControl">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="ContentTemplateSelector" Value="{StaticResource FormEditorSelector}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                        <Setter Property="ContentTemplate" Value="{StaticResource ManualEditor}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  The list of manual values of an object or an array, shown while it is forced in place of its fields.  -->
            <Style x:Key="FormManualHost" TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Content" Value="{Binding}" />
                        <Setter Property="ContentTemplate" Value="{StaticResource ManualEditor}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  Only where the host offers something that fits : a form has no use for null and undefined alone.  -->
            <Style
                x:Key="FormManualToggle"
                BasedOn="{StaticResource DataManualToggle}"
                TargetType="ToggleButton">
                <Setter Property="IsEnabled" Value="True" />
                <Setter Property="ToolTip" Value="Point the field at a value instead" />
                <Setter Property="Visibility">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource ManualToggleVisibilityConverter}">
                            <Binding />
                            <Binding Path="ManualValues" RelativeSource="{RelativeSource AncestorType={x:Type local:DataControlBase}}" />
                            <Binding Path="IsManual" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  The label of a field, marked when required, and its toggle. An array item has neither : its index says nothing.  -->
            <DataTemplate x:Key="FormFieldHeader">
                <Grid toolkit:Spacing.Gap="4" Visibility="{Binding IsArrayItem, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding Label}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                        Text="*"
                        ToolTip="Required"
                        Visibility="{Binding IsRequired, Converter={x:Static jonverters:VisibilityConverter.Default}}" />
                    <ToggleButton
                        Grid.Column="2"
                        toolkit:Sizing.Size="xs"
                        Style="{StaticResource DataManualToggle}">
                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Feather}" />
                    </ToggleButton>
                </Grid>
            </DataTemplate>

            <Style x:Key="FormDescription" TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Description}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}" />
                <Setter Property="toolkit:Sizing.Size" Value="sm" />
                <Setter Property="Visibility" Value="{Binding Description, Converter={x:Static jonverters:VisibilityConverter.Default}}" />
            </Style>

            <!--  The line on the left that sets apart the fields of an object, or an array item.  -->
            <Style x:Key="FormGroupLine" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DisplayBorder0Brush}}" />
                <Setter Property="BorderThickness" Value="1,0,0,0" />
            </Style>

            <!--  A value : its label above its editor.  -->
            <DataTemplate x:Key="FormValueField">
                <StackPanel toolkit:Spacing.Gap="2">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FormFieldHeader}" />
                    <ContentControl Content="{Binding}" Style="{StaticResource FormEditorHost}" />
                    <TextBlock Style="{StaticResource FormDescription}" />
                </StackPanel>
            </DataTemplate>

            <!--  A boolean : a single checkbox holding the label, its toggle on the right. An array item has neither label nor toggle.  -->
            <DataTemplate x:Key="FormBooleanField">
                <StackPanel toolkit:Spacing.Gap="2">
                    <Grid toolkit:Spacing.Gap="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Value}">
                            <CheckBox.Style>
                                <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
                                    <Setter Property="Content" Value="{Binding Label}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArrayItem}" Value="True">
                                            <Setter Property="Content" Value="{x:Null}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <ToggleButton
                            Grid.Column="1"
                            toolkit:Sizing.Size="xs"
                            Style="{StaticResource DataManualToggle}"
                            Visibility="{Binding IsArrayItem, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Feather}" />
                        </ToggleButton>
                    </Grid>
                    <TextBlock Style="{StaticResource FormDescription}" />
                </StackPanel>
            </DataTemplate>

            <!--  A forced boolean has no checkbox left to hold its label : it is shown as any other value.  -->
            <Style x:Key="FormValueHost" TargetType="ContentControl">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate" Value="{StaticResource FormValueField}" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Type}" Value="Boolean" />
                            <Condition Binding="{Binding IsManual}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="ContentTemplate" Value="{StaticResource FormBooleanField}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!--#region One template per kind of node, shown recursively-->
            <DataTemplate DataType="{x:Type jodels:DataValue}">
                <ContentControl Content="{Binding}" Style="{StaticResource FormValueHost}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type jodels:DataObject}">
                <StackPanel toolkit:Spacing.Gap="2">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FormFieldHeader}" />
                    <TextBlock Style="{StaticResource FormDescription}" />
                    <Grid>
                        <ContentControl Style="{StaticResource FormManualHost}" />
                        <!--  The fields of the object, set apart by a line on their left. An array item has the line of its item already.  -->
                        <Border Visibility="{Binding IsManual, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                            <Border.Style>
                                <Style BasedOn="{StaticResource FormGroupLine}" TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArrayItem}" Value="True">
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ItemsControl ItemsSource="{Binding Properties}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsArrayItem}" Value="True">
                                                <Setter Property="toolkit:Derive.MarginFactor" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="{StaticResource ItemsSpacing}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type jodels:DataArray}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FormFieldHeader}" />
                    <Grid>
                        <ContentControl Style="{StaticResource FormManualHost}" />
                        <!--  An array of strings is a list of tags, typed then added with Enter.  -->
                        <jnputs:ComboBoxTags
                            AllowAdd="True"
                            IsEditable="True"
                            SelectedItems="{Binding Converter={StaticResource ArrayValuesConverter}}">
                            <jnputs:ComboBoxTags.Style>
                                <!--  The theme style still applies under this one : it comes from Generic.xaml.  -->
                                <Style TargetType="jnputs:ComboBoxTags">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Template.Type}" Value="String" />
                                                <Condition Binding="{Binding IsManual}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </jnputs:ComboBoxTags.Style>
                        </jnputs:ComboBoxTags>
                        <!--  Any other array lists its items, each with its own editor.  -->
                        <StackPanel toolkit:Spacing.Gap="4">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManual}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Template.Type}" Value="String">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ItemsControl ItemsSource="{Binding Values}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="{StaticResource ItemsSpacing}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <!--  Any item, whatever its kind, is set apart by a line on its left, its remove button at the end of it.  -->
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"
                                                toolkit:Derive.BorderThickness="{x:Static joufflu:Dimensions.DisplayThickness}"
                                                toolkit:Derive.BorderThicknessFactor="1,0,0,0"
                                                BorderBrush="{DynamicResource {x:Static joufflu:Brushes.DisplayBorder0Brush}}" />

                                            <Button
                                                Grid.Row="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                toolkit:Sizing.Size="xs"
                                                Style="{StaticResource DataRemoveButton}">
                                                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                                            </Button>

                                            <ContentPresenter Grid.Column="1" Content="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                HorizontalAlignment="Left"
                                toolkit:Sizing.Size="sm"
                                Command="{Binding AddFromTemplateCommand}"
                                Style="{StaticResource SoftPrimaryButton}">
                                <StackPanel toolkit:Spacing.Gap="2" Orientation="Horizontal">
                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Plus}" />
                                    <TextBlock VerticalAlignment="Center">Add</TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FormDescription}" />
                </StackPanel>
            </DataTemplate>
            <!--#endregion-->
        </ResourceDictionary>
    </local:DataControlBase.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl Margin="0,0,4,0" ItemsSource="{Binding Node.Properties}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="{StaticResource ItemsSpacing}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </ScrollViewer>
</local:DataControlBase>
