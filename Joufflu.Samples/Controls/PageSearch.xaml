<UserControl
    x:Class="Joufflu.Samples.Controls.PageSearch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    Width="520"
    d:DataContext="{d:DesignInstance Type=c:PageSearchViewModel}"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <DockPanel>
        <inputs:Search
            x:Name="SearchBox"
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            PreviewKeyDown="SearchBox_PreviewKeyDown"
            SearchText="{Binding Query}" />

        <!--  A fixed height, so the overlay does not resize while the results are filtered.  -->
        <Grid Height="420">
            <ListBox
                x:Name="ResultsList"
                ItemsSource="{Binding Results}"
                PreviewKeyDown="ResultsList_PreviewKeyDown"
                HorizontalContentAlignment="Stretch"
                PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp">
                <ListBox.Style>
                    <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="ListBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type c:PageEntry}">
                        <Grid toolkit:Spacing.Gap="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel toolkit:Spacing.Gap="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock
                                    toolkit:Sizing.Size="sm"
                                    Style="{StaticResource TextMuted}"
                                    Text="{Binding Summary}" />
                            </StackPanel>
                            <!--  A click opens the page.  -->
                            <fonts:FontIcon
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                Text="{x:Static fonts:LucideFontIcons.ArrowRight}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  Empty state, shown in place of the list when nothing matches.  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                toolkit:Spacing.Gap="4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <fonts:FontIcon
                    HorizontalAlignment="Center"
                    toolkit:Sizing.Size="xl"
                    Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                    Text="{x:Static fonts:LucideFontIcons.SearchX}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="No page found" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TextMuted}"
                    Text="Try another word, or clear the search to list every page." />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
