<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  daisyUI's "corporate" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#181A2A</Color>

    <!--  Background  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#E8E8E8</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#FFFFFF</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#D1D1D1</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#0082CE</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#FFFFFF</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#61738D</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#FFFFFF</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#00A43B</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#FFFFFF</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#0090B5</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#FFFFFF</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FDC700</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#000000</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FF6266</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#000000</Color>

</ResourceDictionary>
