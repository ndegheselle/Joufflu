<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Corporate" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#181A2A</Color>

    <!--  Border Colors  -->

    <!--  Background Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#FFFFFF</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#F7F9FC</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#eaecef</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#4B6BFB</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#FFFFFF</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#7B92B2</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#FFFFFF</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#36D399</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#04160B</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#3ABFF8</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#06222E</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FBBD23</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#3A2C00</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#F87272</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#3A0E0E</Color>

</ResourceDictionary>
