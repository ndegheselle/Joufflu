<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  daisyUI's "black" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#D6D6D6</Color>

    <!--  Background  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#000000</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#141414</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#1B1B1B</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#3A3A3A</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#FFFFFF</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#3A3A3A</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#FFFFFF</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#028002</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#D3E6D0</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#0000FF</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#C6DBFF</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FFFF00</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#161600</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FF0301</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#160000</Color>

</ResourceDictionary>
