<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Cupcake" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#291334</Color>
    <Color x:Key="{x:Static joufflu:Colors.Foreground100Color}">#726378</Color>
    <Color x:Key="{x:Static joufflu:Colors.Foreground200Color}">#9C909E</Color>

    <!--  Border Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.BorderColor}">#DCD4CD</Color>
    <Color x:Key="{x:Static joufflu:Colors.Border100Color}">#EBE6E1</Color>

    <!--  Background Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.BackgroundColor}">#FAF7F5</Color>
    <Color x:Key="{x:Static joufflu:Colors.Background100Color}">#EFEAE6</Color>
    <Color x:Key="{x:Static joufflu:Colors.Background200Color}">#E7E2DF</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#65C3C8</Color>
    <Color x:Key="{x:Static joufflu:Colors.Primary100Color}">#56A6AA</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryContentColor}">#093A3E</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#EF9FBC</Color>
    <Color x:Key="{x:Static joufflu:Colors.Secondary100Color}">#CB87A0</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryContentColor}">#45162E</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#00B795</Color>
    <Color x:Key="{x:Static joufflu:Colors.Success100Color}">#009C7F</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessContentColor}">#003A2E</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#EEAF3A</Color>
    <Color x:Key="{x:Static joufflu:Colors.Info100Color}">#CA9531</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoContentColor}">#3A2A06</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#F3CC30</Color>
    <Color x:Key="{x:Static joufflu:Colors.Warning100Color}">#CFAD29</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningContentColor}">#3A3206</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FF6F70</Color>
    <Color x:Key="{x:Static joufflu:Colors.Danger100Color}">#D95E5F</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerContentColor}">#3A0E0E</Color>

</ResourceDictionary>
