<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Cupcake" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#291334</Color>

    <!--  Border Colors  -->

    <!--  Background Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#FAF7F5</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#EFEAE6</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#e3dddb</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#65C3C8</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#093A3E</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#EF9FBC</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#45162E</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#00B795</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#003A2E</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#EEAF3A</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#3A2A06</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#F3CC30</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#3A3206</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FF6F70</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#3A0E0E</Color>

</ResourceDictionary>
