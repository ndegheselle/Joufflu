<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--
        A high contrast "Debug" palette: every token gets its own loud, unrelated colour so you can tell
        at a glance which token paints which part of a control. Not meant to look good.
        Legend: Foreground white | Stroke magenta | Background black, Middleground navy |
        Primary orange, Secondary purple,
        Success lime, Info blue, Warning yellow, Danger red (each: base, Content = text on it; the hover is derived from the base).
    -->

    <!--  Foreground  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#FFFFFFFF</Color>

    <!--  Background  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">Yellow</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">Magenta</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">Cyan</Color>

    <!--  Primary: orange, black content  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">Red</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#FF000000</Color>

    <!--  Secondary: purple, white content  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">Blue</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#FFFFFFFF</Color>

    <!--  Success: lime, black content  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">Green</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#FF000000</Color>

    <!--  Info: blue, white content  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">Blue</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#FFFFFFFF</Color>

    <!--  Warning: yellow, black content  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">Yellow</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#FF000000</Color>

    <!--  Danger: red, white content  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">Red</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#FFFFFFFF</Color>

</ResourceDictionary>
