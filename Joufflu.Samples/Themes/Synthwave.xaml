<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Synthwave" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#F9F7FD</Color>

    <!--  Border Colors  -->

    <!--  Background Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#1B1235</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#241A4A</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#312755</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#E779C1</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#2A0A20</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#58C7F3</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#06222E</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#71EAD2</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#05261F</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#53C0F3</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#06222E</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#E2D562</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#2E2905</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FD6F9C</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#2E0716</Color>

</ResourceDictionary>
