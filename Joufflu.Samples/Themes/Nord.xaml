<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Nord" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#2E3440</Color>

    <!--  Border Colors  -->

    <!--  Background Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#ECEFF4</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#E5E9F0</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#dadee5</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#5E81AC</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#FFFFFF</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#81A1C1</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#10151D</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#A3BE8C</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#10201A</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#88C0D0</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#0A2027</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#EBCB8B</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#2E2606</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#BF616A</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#FFFFFF</Color>

</ResourceDictionary>
