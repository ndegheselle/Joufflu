<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Nord" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#2E3440</Color>
    <Color x:Key="{x:Static joufflu:Colors.Foreground100Color}">#70757F</Color>
    <Color x:Key="{x:Static joufflu:Colors.Foreground200Color}">#969BA3</Color>

    <!--  Border Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.BorderColor}">#D8DEE9</Color>
    <Color x:Key="{x:Static joufflu:Colors.Border100Color}">#E2E6EE</Color>

    <!--  Background Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.BackgroundColor}">#ECEFF4</Color>
    <Color x:Key="{x:Static joufflu:Colors.Background100Color}">#E5E9F0</Color>
    <Color x:Key="{x:Static joufflu:Colors.Background200Color}">#D8DEE9</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#5E81AC</Color>
    <Color x:Key="{x:Static joufflu:Colors.Primary100Color}">#506E92</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryContentColor}">#FFFFFF</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#81A1C1</Color>
    <Color x:Key="{x:Static joufflu:Colors.Secondary100Color}">#6E89A4</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryContentColor}">#10151D</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#A3BE8C</Color>
    <Color x:Key="{x:Static joufflu:Colors.Success100Color}">#8BA277</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessContentColor}">#10201A</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#88C0D0</Color>
    <Color x:Key="{x:Static joufflu:Colors.Info100Color}">#74A3B1</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoContentColor}">#0A2027</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#EBCB8B</Color>
    <Color x:Key="{x:Static joufflu:Colors.Warning100Color}">#C8AD76</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningContentColor}">#2E2606</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#BF616A</Color>
    <Color x:Key="{x:Static joufflu:Colors.Danger100Color}">#A2525A</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerContentColor}">#FFFFFF</Color>

</ResourceDictionary>
