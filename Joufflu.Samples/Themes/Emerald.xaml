<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Emerald" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#333C4D</Color>

    <!--  Border Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.StrokeColor}">#E5E7EB</Color>

    <!--  Background Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.BackgroundColor}">#FFFFFF</Color>
    <Color x:Key="{x:Static joufflu:Colors.MiddlegroundColor}">#F4F6F8</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#66CC8A</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryContentColor}">#04160B</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#377CFB</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryContentColor}">#FFFFFF</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#00A96E</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessContentColor}">#FFFFFF</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#F68067</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoContentColor}">#2A0F08</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FFBE00</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningContentColor}">#3A2C00</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#F87272</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerContentColor}">#3A0E0E</Color>

</ResourceDictionary>
