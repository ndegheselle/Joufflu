<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Dracula" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#F8F8F2</Color>

    <!--  Border Colors  -->

    <!--  Background Colors  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#282A36</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#343746</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#404350</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#FF79C6</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#1A1423</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#BD93F9</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#1A1423</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#50FA7B</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#05260F</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#8BE9FD</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#06222A</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#F1FA8C</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#2E2E05</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FF5555</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#2E0707</Color>

</ResourceDictionary>
