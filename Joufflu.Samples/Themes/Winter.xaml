<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  daisyUI's "winter" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <!--  Foreground  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#394E6A</Color>

    <!--  Background  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#F2F7FE</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#FFFFFF</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#E3E9F4</Color>

    <!--  Primary  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#0069FF</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#CEE4FF</Color>

    <!--  Secondary  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#463AA2</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#D5D7EE</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#81CFD1</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#060F10</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#94E7FB</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#081315</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#EFD7BC</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#14110D</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#E58B8B</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#120707</Color>

</ResourceDictionary>
