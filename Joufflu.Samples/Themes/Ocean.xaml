<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Ocean" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#E6F1F5</Color>


    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#0B1E27</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#12303B</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#1f3c46</Color>

    <!--  Primary: teal  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#2DD4BF</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#04211D</Color>

    <!--  Secondary: sky  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#38BDF8</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#04212B</Color>

    <!--  Success: emerald  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#34D399</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#04231A</Color>

    <!--  Info: blue  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#60A5FA</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#06203F</Color>

    <!--  Warning: amber  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FBBF24</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#3A2A04</Color>

    <!--  Danger: rose  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FB7185</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#3A0A14</Color>

</ResourceDictionary>
