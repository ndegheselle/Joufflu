<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">

    <!--  A custom "Ocean" palette shipped by the sample app, registered with ThemeManager at startup.  -->

    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#E6F1F5</Color>
    <Color x:Key="{x:Static joufflu:Colors.Foreground100Color}">#9FBECB</Color>
    <Color x:Key="{x:Static joufflu:Colors.Foreground200Color}">#7FA6B4</Color>

    <Color x:Key="{x:Static joufflu:Colors.BorderColor}">#1B4250</Color>
    <Color x:Key="{x:Static joufflu:Colors.Border100Color}">#2A5A6B</Color>

    <Color x:Key="{x:Static joufflu:Colors.BackgroundColor}">#0B1E27</Color>
    <Color x:Key="{x:Static joufflu:Colors.Background100Color}">#12303B</Color>
    <Color x:Key="{x:Static joufflu:Colors.Background200Color}">#1B4250</Color>

    <!--  Primary: teal  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#2DD4BF</Color>
    <Color x:Key="{x:Static joufflu:Colors.Primary100Color}">#26B8A6</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryContentColor}">#04211D</Color>

    <!--  Secondary: sky  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#38BDF8</Color>
    <Color x:Key="{x:Static joufflu:Colors.Secondary100Color}">#2FA6DB</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryContentColor}">#04212B</Color>

    <!--  Success: emerald  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#34D399</Color>
    <Color x:Key="{x:Static joufflu:Colors.Success100Color}">#2CB985</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessContentColor}">#04231A</Color>

    <!--  Info: blue  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#60A5FA</Color>
    <Color x:Key="{x:Static joufflu:Colors.Info100Color}">#4B8FE0</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoContentColor}">#06203F</Color>

    <!--  Warning: amber  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FBBF24</Color>
    <Color x:Key="{x:Static joufflu:Colors.Warning100Color}">#E0A91E</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningContentColor}">#3A2A04</Color>

    <!--  Danger: rose  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FB7185</Color>
    <Color x:Key="{x:Static joufflu:Colors.Danger100Color}">#E05F72</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerContentColor}">#3A0A14</Color>

</ResourceDictionary>
