<UserControl
    x:Class="Joufflu.Samples.Views.FileExplorer.FileExplorerSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:converters="clr-namespace:Joufflu.FileExplorer.Converters;assembly=Joufflu.FileExplorer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fileExplorer="clr-namespace:Joufflu.FileExplorer.Controls;assembly=Joufflu.FileExplorer"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.FileExplorer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:FileExplorerSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel joufflu:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="File explorer" />

            <c:CodeExample
                Title="ExplorerList"
                Code="{Binding ExplorerListCode}"
                Description="Lists the nodes of the opened folder, directories first then by natural name order. Double click a folder to open it, right click a node for its menu.">
                <fileExplorer:ExplorerList Height="300" Loader="{Binding Loader}" />
            </c:CodeExample>

            <c:CodeExample
                Title="ExplorerTree"
                Code="{Binding ExplorerTreeCode}"
                Description="Shows the loaded folders and files as a hierarchy, each level sorted on its own so it stays independent from the list.">
                <fileExplorer:ExplorerTree Height="300" Loader="{Binding Loader}" />
            </c:CodeExample>

            <c:CodeExample
                Title="ExplorerControlBar"
                Code="{Binding ExplorerControlBarCode}"
                Description="Navigates the loader : back and forward through the visited folders, up to the parent one, and a breadcrumb of the path leading to the opened folder. It shares its loader with the list below, as with the two samples above.">
                <StackPanel joufflu:Spacing.Gap="4">
                    <fileExplorer:ExplorerControlBar Loader="{Binding Loader}" />
                    <fileExplorer:ExplorerList Height="200" Loader="{Binding Loader}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Explorer"
                Code="{Binding ExplorerCode}"
                Description="Everything together : the control bar, the tree of the loaded hierarchy next to the list of the opened folder, and a status bar counting its items and the selected ones.">
                <fileExplorer:Explorer Height="400" Loader="{Binding ExplorerLoader}" />
            </c:CodeExample>

            <c:CodeExample
                Title="Custom node template"
                Code="{Binding CustomNodeTemplateCode}"
                Description="The node visuals are implicit templates keyed by node type : redeclaring one in the resources of a control replaces it there only. Here ExplorerIconConverter trades the font icons for the icons the system associates with each file type.">
                <fileExplorer:ExplorerList Height="300" Loader="{Binding Loader}">
                    <fileExplorer:ExplorerList.Resources>
                        <!--  Files and folders share it : the converter tells them apart on its own.  -->
                        <DataTemplate x:Key="NodeWithSystemIcon">
                            <StackPanel joufflu:Spacing.Gap="4" Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{Binding Converter={x:Static converters:ExplorerIconConverter.Small}}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type fileExplorer:PhysicalFile}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeWithSystemIcon}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type fileExplorer:PhysicalDirectory}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeWithSystemIcon}" />
                        </DataTemplate>
                    </fileExplorer:ExplorerList.Resources>
                </fileExplorer:ExplorerList>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
