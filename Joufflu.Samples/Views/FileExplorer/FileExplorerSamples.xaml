<UserControl
    x:Class="Joufflu.Samples.Views.FileExplorer.FileExplorerSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fileExplorer="clr-namespace:Joufflu.FileExplorer.Controls;assembly=Joufflu.FileExplorer"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.FileExplorer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:FileExplorerSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel joufflu:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="File explorer" />

            <c:CodeExample
                Title="ExplorerList"
                Code="{Binding ExplorerListCode}"
                Description="Lists the nodes of the opened folder, directories first then by natural name order. Double click a folder to open it, right click a node for its menu.">
                <fileExplorer:ExplorerList Height="300" Loader="{Binding Loader}" />
            </c:CodeExample>

            <c:CodeExample
                Title="ExplorerTree"
                Code="{Binding ExplorerTreeCode}"
                Description="Shows the loaded folders and files as a hierarchy, each level sorted on its own so it stays independent from the list.">
                <fileExplorer:ExplorerTree Height="300" Loader="{Binding Loader}" />
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
