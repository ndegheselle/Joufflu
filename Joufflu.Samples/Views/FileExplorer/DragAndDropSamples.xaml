<UserControl
    x:Class="Joufflu.Samples.Views.FileExplorer.DragAndDropSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnd="clr-namespace:Joufflu.FileExplorer.DragAndDrop;assembly=Joufflu.FileExplorer"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.FileExplorer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:DragAndDropSamplesViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Shown under the cursor while dragging, its DataContext is the dragged node  -->
        <DataTemplate x:Key="NodeDragAdorner">
            <Border
                Padding="{StaticResource {x:Static joufflu:Dimensions.ControlPaddingSm}}"
                Background="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}"
                CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                <TextBlock Foreground="{DynamicResource {x:Static joufflu:Brushes.PrimaryContentBrush}}" Text="{Binding Name}" />
            </Border>
        </DataTemplate>

        <!--  Drop.IsHovering is set on the row the cursor passes over, when the drop is allowed  -->
        <Style
            x:Key="DroppableNodeItem"
            BasedOn="{StaticResource {x:Type ListBoxItem}}"
            TargetType="ListBoxItem">
            <Style.Triggers>
                <Trigger Property="dnd:Drop.IsHovering" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.Primary100Brush}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryContentBrush}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel joufflu:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Drag and drop" />

            <c:CodeExample
                Title="Reordering a list"
                Code="{Binding ReorderCode}"
                Description="Drag.Handler starts the drag and Drop.Handler applies it, both bound from the view model. The row under the cursor is highlighted through the read only Drop.IsHovering, and the dragged node follows the cursor in an adorner built from Drag.AdornerTemplate.">
                <ListBox
                    Height="250"
                    dnd:Drag.AdornerTemplate="{StaticResource NodeDragAdorner}"
                    dnd:Drag.Handler="{Binding NodeDragHandler}"
                    dnd:Drop.Handler="{Binding NodeDropHandler}"
                    DisplayMemberPath="Name"
                    ItemContainerStyle="{StaticResource DroppableNodeItem}"
                    ItemsSource="{Binding Nodes}" />
            </c:CodeExample>

            <c:CodeExample
                Title="Receiving files from the Windows explorer"
                Code="{Binding FileDropCode}"
                Description="A drop handler reads the dropped paths from DropContext.FilePaths, and the border reacts to the read only Drop.IsHovering while a drop it accepts hovers it. Drop some files from the Windows explorer here.">
                <Border MinHeight="120" dnd:Drop.Handler="{Binding FileDropHandler}">
                    <!--  Every value the trigger changes has to come from the style, a local value would win over it  -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <!--  Transparent and not null, otherwise the border is not hit tested  -->
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}" />
                            <Setter Property="BorderThickness" Value="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}" />
                            <Setter Property="CornerRadius" Value="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}" />
                            <Style.Triggers>
                                <Trigger Property="dnd:Drop.IsHovering" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}" />
                                    <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.Background200Brush}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                        Text="{Binding DroppedFilesText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
