<UserControl
    x:Class="Joufflu.Samples.Views.FileExplorer.ExplorerSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:converters="clr-namespace:Joufflu.FileExplorer.Converters;assembly=Joufflu.FileExplorer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Joufflu.FileExplorer.Data;assembly=Joufflu.FileExplorer"
    xmlns:fileExplorer="clr-namespace:Joufflu.FileExplorer.Controls;assembly=Joufflu.FileExplorer"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.FileExplorer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ExplorerSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel joufflu:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Explorer" />

            <c:CodeExample
                Title="Explorer"
                Code="{Binding ExplorerCode}"
                Description="Everything together : the control bar, the tree of the loaded hierarchy next to the list of the opened folder, and a status bar counting its items and the selected ones. A session holds where the user is, a source holds where the nodes come from.">
                <fileExplorer:Explorer Height="400" Session="{Binding Session}" />
            </c:CodeExample>

            <c:CodeExample
                Title="Custom node template"
                Code="{Binding CustomNodeTemplateCode}"
                Description="The node visuals are implicit templates keyed by node type : redeclaring one in the resources of a control replaces it there only. Here ExplorerIconConverter trades the font icons for the icons the system associates with each file type.">
                <fileExplorer:Explorer Height="400" Session="{Binding Session}">
                    <fileExplorer:Explorer.Resources>
                        <!--  Files and folders share it : the converter tells them apart on its own.  -->
                        <DataTemplate x:Key="NodeWithSystemIcon">
                            <StackPanel joufflu:Spacing.Gap="4" Orientation="Horizontal">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{Binding Converter={x:Static converters:ExplorerIconConverter.Small}}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                        <!--
                            One entry is enough : the implicit template lookup walks base CLASSES, and every node of a
                            physical source derives from ExplorerNode. Keying it on IExplorerNode would not work, that
                            lookup never considering interfaces.
                        -->
                        <DataTemplate DataType="{x:Type data:ExplorerNode}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeWithSystemIcon}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type data:ExplorerDirectory}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeWithSystemIcon}" />
                        </DataTemplate>
                    </fileExplorer:Explorer.Resources>
                </fileExplorer:Explorer>
            </c:CodeExample>

            <c:CodeExample
                Title="Drag and drop"
                Code="{Binding DragAndDropCode}"
                Description="Drag between the two explorers, out to the Windows file explorer, and in from it. Ctrl forces a copy and Shift a move ; inside one explorer a drag moves, between two it copies. A folder cannot be dropped into itself or into one of its own descendants, and the hovered folder is outlined.">
                <Grid joufflu:Spacing.Gap="8" Height="360">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <fileExplorer:Explorer Session="{Binding Session}" />
                    <fileExplorer:Explorer Grid.Column="1" Session="{Binding OtherSession}" />
                </Grid>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
