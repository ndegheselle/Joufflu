<UserControl
    x:Class="Joufflu.Samples.Views.FileExplorer.ExplorerSourceSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Joufflu.FileExplorer.Controls.Base;assembly=Joufflu.FileExplorer"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fileExplorer="clr-namespace:Joufflu.FileExplorer.Controls;assembly=Joufflu.FileExplorer"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.FileExplorer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ExplorerSourceSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel joufflu:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Sources" />
            <TextBlock
                Style="{StaticResource Muted}"
                Text="A source says where the nodes come from and which mutations it accepts. Only two members are required ; everything else is opt-in, and what a source leaves alone disables the matching menu items on its own."
                TextWrapping="Wrap" />

            <c:CodeExample
                Title="A source with data and a menu of its own"
                Code="{Binding CustomSourceCode}"
                Description="A source builds its nodes, so it can build a type of its own : ReviewSource returns ReviewedFile, whose extra property fills a column added through ExtraColumns. A context menu keyed on that type replaces the default one, and reaches a command of the source through Session.Source without the library knowing it exists. VisibleNodes keeps the files only, folders having no review state.">
                <fileExplorer:ExplorerList
                    Height="300"
                    Session="{Binding ReviewSession}"
                    VisibleNodes="Files">
                    <fileExplorer:ExplorerList.Resources>
                        <!--  Keyed on the node type : found before the default keyed on PhysicalFile.  -->
                        <DataTemplate x:Key="{base:ContextMenuTemplateKey local:ReviewedFile}">
                            <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
                                <MenuItem
                                    Command="{Binding Session.Source.MarkReviewedCommand}"
                                    CommandParameter="{Binding Nodes}"
                                    Header="Mark as reviewed">
                                    <MenuItem.Icon>
                                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Check}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Command="{Binding Session.OpenWithDefaultApplicationCommand}"
                                    CommandParameter="{Binding Node}"
                                    Header="Open" />
                                <MenuItem
                                    Command="{Binding Owner.BeginRenameCommand}"
                                    CommandParameter="{Binding Node}"
                                    Header="Rename"
                                    InputGestureText="F2" />
                                <MenuItem
                                    Command="{Binding Session.DeleteCommand}"
                                    CommandParameter="{Binding Nodes}"
                                    Header="Delete"
                                    InputGestureText="Del"
                                    Style="{StaticResource DangerMenuItem}" />
                            </ContextMenu>
                        </DataTemplate>
                    </fileExplorer:ExplorerList.Resources>
                    <fileExplorer:ExplorerList.ExtraColumns>
                        <GridViewColumn Width="100" DisplayMemberBinding="{Binding Review}" Header="Review" />
                    </fileExplorer:ExplorerList.ExtraColumns>
                </fileExplorer:ExplorerList>
            </c:CodeExample>

            <c:CodeExample
                Title="A source with nothing on the disk"
                Code="{Binding VirtualSourceCode}"
                Description="These notes exist only in memory. They get the default node visuals through the ExplorerNode base class, NodeActivated opens one since a virtual file has no application to be handed to, and every operation the source did not opt into is disabled : right click one and Rename and Delete are greyed, while 'Show in file explorer' is not even there.">
                <Grid joufflu:Spacing.Gap="8" Height="240">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <fileExplorer:ExplorerTree
                        NodeActivated="OnNoteActivated"
                        Session="{Binding NotesSession}"
                        VisibleNodes="All" />

                    <Border
                        Grid.Column="1"
                        Padding="8"
                        Background="{DynamicResource {x:Static joufflu:Brushes.Background100Brush}}"
                        CornerRadius="{StaticResource {x:Static joufflu:Dimensions.CornerRadius}}">
                        <TextBlock Text="{Binding OpenedNote}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </c:CodeExample>

            <c:CodeExample
                Title="A source for anything else"
                Code="{Binding RemoteSourceCode}"
                Description="The same shape serves a server, an archive or a database. Reading is asynchronous, so a slow source shows the progress bar of the control bar instead of freezing the interface, and a navigation the user gives up on is cancelled rather than queued." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
