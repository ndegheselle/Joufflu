<UserControl
    x:Class="Joufflu.Samples.Views.Toolkit.ShellSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            joufflu:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock
                Style="{StaticResource H1}"
                Text="Application shell" />

            <TextBlock
                Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                Text="These styles shape the whole window rather than a control on a page — this gallery window itself is the live example. The snippets below show how to wire them up."
                TextWrapping="Wrap" />

            <c:CodeExample
                Title="Window"
                Description="The default Window style themes a standard WPF window (background, foreground and native chrome) to match the design system."
                Code="&lt;Window ...&gt;&#x0a;    &lt;!-- inherits the themed Window style automatically --&gt;&#x0a;&lt;/Window&gt;">
                <TextBlock
                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                    Text="Applied implicitly to every Window." />
            </c:CodeExample>

            <c:CodeExample
                Title="ThemedWindow"
                Description="ThemedWindow is a custom window with a fully styled title bar and caption buttons. This gallery's MainWindow derives from it."
                Code="&lt;controls:ThemedWindow xmlns:controls=&quot;clr-namespace:Joufflu.Controls;assembly=Joufflu&quot;&#x0a;                       Title=&quot;My app&quot;&gt;&#x0a;    ...&#x0a;&lt;/controls:ThemedWindow&gt;">
                <TextBlock
                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                    Text="You are looking at a ThemedWindow right now." />
            </c:CodeExample>

            <c:CodeExample
                Title="OverlayContainer and ToastContainer"
                Description="Each container wraps the whole app and layers one thing above it: OverlayContainer (Joufflu.Navigation) the modal overlays, ToastContainer (Joufflu.Feedback) the toasts. Wrapping everything is what lets a full screen overlay cover the side menu too; nesting the overlays inside the toasts keeps the toasts on top. The current page needs no dedicated container: bind a ContentControl to the shared Navigator."
                Code="&lt;feedback:ToastContainer Toasts=&quot;{Binding Toasts}&quot;&gt;&#x0a;    &lt;nav:OverlayContainer Overlays=&quot;{Binding Overlays}&quot;&gt;&#x0a;        &lt;DockPanel&gt;&#x0a;            &lt;nav:NavigationMenu DockPanel.Dock=&quot;Left&quot; Navigator=&quot;{Binding Navigator}&quot; /&gt;&#x0a;            &lt;ContentControl Content=&quot;{Binding Navigator.CurrentPage}&quot; /&gt;&#x0a;        &lt;/DockPanel&gt;&#x0a;    &lt;/nav:OverlayContainer&gt;&#x0a;&lt;/feedback:ToastContainer&gt;">
                <TextBlock
                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                    Text="This whole window is wrapped in both containers; the right-hand area is a ContentControl bound to the navigator." />
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
