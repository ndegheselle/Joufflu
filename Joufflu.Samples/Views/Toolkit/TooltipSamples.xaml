<UserControl
    x:Class="Joufflu.Samples.Views.Toolkit.TooltipSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Toolkit"
    d:DataContext="{d:DesignInstance Type=vm:TooltipSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock toolkit:Sizing.Size="xl" FontWeight="Bold" TextWrapping="Wrap" Text="Tooltip" />

            <c:CodeExample
                Title="ThemedTooltip.Placement"
                Code="{Binding PlacementCode}"
                Description="Set ToolTip as usual: every tooltip is themed. ThemedTooltip.Placement chooses the side it sits on, centred on the element — Top, Bottom (the default), Left or Right — and it flips to the opposite side near a screen edge.">
                <WrapPanel toolkit:Spacing.Gap="8,8">
                    <Button
                        Content="Top"
                        ToolTip="Placed above"
                        toolkit:ThemedTooltip.Placement="Top" />
                    <Button
                        Content="Bottom"
                        ToolTip="Placed below"
                        toolkit:ThemedTooltip.Placement="Bottom" />
                    <Button
                        Content="Left"
                        ToolTip="Placed left"
                        toolkit:ThemedTooltip.Placement="Left" />
                    <Button
                        Content="Right"
                        ToolTip="Placed right"
                        toolkit:ThemedTooltip.Placement="Right" />
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Custom content"
                Code="{Binding ContentCode}"
                Description="ToolTip is an object, so it accepts arbitrary XAML — not just text.">
                <WrapPanel toolkit:Spacing.Gap="8,8">
                    <Button Content="Rich tooltip" toolkit:ThemedTooltip.Placement="Bottom">
                        <Button.ToolTip>
                            <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="8">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Info}" />
                                <TextBlock Text="Arbitrary content, icons included." />
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="ThemedTooltip.MaxWidth"
                Code="{Binding MaxWidthCode}"
                Description="A tooltip is no wider than ThemedTooltip.MaxWidth (320 by default), past which its text wraps.">
                <WrapPanel toolkit:Spacing.Gap="8,8">
                    <Button Content="Default width" ToolTip="A long description of what this button does, wrapped once it reaches the default max width of a tooltip rather than running across the screen." />
                    <Button
                        Content="Narrow"
                        toolkit:ThemedTooltip.MaxWidth="160"
                        ToolTip="The same long description, wrapped at a narrower max width set on the element." />
                </WrapPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
