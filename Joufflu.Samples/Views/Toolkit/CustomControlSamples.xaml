<UserControl
    x:Class="Joufflu.Samples.Views.Toolkit.CustomControlSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.Toolkit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    d:DataContext="{d:DesignInstance Type=local:CustomControlSamplesViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Joufflu.Samples;component/Views/Toolkit/RatingInput.xaml" />
    </UserControl.Resources>

    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock toolkit:Sizing.Size="xl" FontWeight="Bold" TextWrapping="Wrap" Text="Create a custom control" />
            <TextBlock
                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                Text="A control of your own sits with the Joufflu ones when it reads the tokens of its category, so a theme restyling that category restyles it too. Pick the category the control belongs to, then follow its rules. A control derived from a native one (TextBox, Button, ListBox…) gets them all by basing its style on the native one."
                TextWrapping="Wrap" />

            <!--  The three categories, what each is for, the tokens it reads and its states  -->
            <UniformGrid toolkit:Spacing.Gap="8" Columns="3">
                <Border Style="{StaticResource Card}">
                    <StackPanel toolkit:Spacing.Gap="0,6">
                        <TextBlock toolkit:Sizing.Size="lg" FontWeight="SemiBold" Text="Display" />
                        <TextBlock Text="Shows content without being interacted with: a card, a popup, a tooltip, a panel, the frame of a list." TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                            Text="DisplayBase/Border/Elevated/InteractionBrush, DisplayRadius, DisplayThickness, DisplayPadding (DisplayPaddingSm when compact)."
                            TextWrapping="Wrap" />
                        <TextBlock Text="No interaction of its own (DisplayInteractionBrush is there for an informative hover). Its items (rows, entries) are actions without a fill at rest." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel toolkit:Spacing.Gap="0,6">
                        <TextBlock toolkit:Sizing.Size="lg" FontWeight="SemiBold" Text="Input" />
                        <TextBlock Text="Takes a value: a text field, a picker, a rating, a check." TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                            Text="InputBase/Border/Elevated/InteractionBrush, InputRadius, InputThickness, InputPaddingXs..Lg, HeightXs..Lg."
                            TextWrapping="Wrap" />
                        <TextBlock Text="No hover; on focus the border turns InputElevatedBrush and the background InputInteractionBrush. The example below builds one." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel toolkit:Spacing.Gap="0,6">
                        <TextBlock toolkit:Sizing.Size="lg" FontWeight="SemiBold" Text="Action" />
                        <TextBlock Text="Runs something: a button, a toggle, an item of a display." TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                            Text="ActionBase/Border/Elevated/InteractionBrush, ActionRadius, ActionThickness, ActionPaddingXs..Lg, HeightXs..Lg."
                            TextWrapping="Wrap" />
                        <TextBlock Text="On hover the border turns ActionElevatedBrush and the background ActionInteractionBrush, moved down when pressed, no focus border." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock TextWrapping="Wrap">
                <Run Text="Every category: disabled is DisabledOpacity, selected and checked the primary, sizes follow Sizing.Size. The" />
                <Hyperlink Command="{Binding OpenDesignTokensCommand}">Design tokens</Hyperlink>
                <Run Text="page lists each key with its role and fallback." />
            </TextBlock>

            <TextBlock
                Margin="0,8,0,0"
                toolkit:Sizing.Size="lg"
                FontWeight="Bold"
                Text="Example: an input"
                TextWrapping="Wrap" />
            <TextBlock
                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                Text="The RatingInput below derives from a bare Control, so it follows every rule of the Input category by hand. A display or an action follows the same steps with the keys of its own category."
                TextWrapping="Wrap" />

            <c:CodeExample
                Title="Minimum"
                Code="{Binding MinimumCode}"
                Description="Background, border colour and thickness, radius, the md padding and a one-line height, all from the input tokens: the input matches the text box next to it and follows the theme. Without the optional part it keeps its md size whatever Sizing.Size says (second row, lg) and has no focus state.">
                <Grid toolkit:Spacing.Gap="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBox Text="A text box" />
                    <local:RatingInput
                        Grid.Column="1"
                        Style="{StaticResource RatingInputMinimal}"
                        Value="{Binding Rating}" />
                    <TextBox
                        Grid.Row="1"
                        toolkit:Sizing.Size="lg"
                        Text="A text box" />
                    <local:RatingInput
                        Grid.Row="1"
                        Grid.Column="1"
                        toolkit:Sizing.Size="lg"
                        Style="{StaticResource RatingInputMinimal}"
                        Value="{Binding Rating}" />
                </Grid>
            </c:CodeExample>

            <c:CodeExample
                Title="Sizes, padding and states"
                Code="{Binding SizesCode}"
                Description="Optional: the Sizing.Size triggers set the height, font size and input padding of each size, and the focus trigger matches the native inputs: no hover, a strong border on focus. The height comes from the size, so the content takes only the horizontal part of Padding and is centred: the stars line up with the text of the text box.">
                <Grid toolkit:Spacing.Gap="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBox toolkit:Sizing.Size="xs" Text="Extra small" />
                    <local:RatingInput
                        Grid.Column="1"
                        toolkit:Sizing.Size="xs"
                        Value="{Binding Rating}" />
                    <TextBox
                        Grid.Row="1"
                        toolkit:Sizing.Size="sm"
                        Text="Small" />
                    <local:RatingInput
                        Grid.Row="1"
                        Grid.Column="1"
                        toolkit:Sizing.Size="sm"
                        Value="{Binding Rating}" />
                    <TextBox Grid.Row="2" Text="Medium" />
                    <local:RatingInput
                        Grid.Row="2"
                        Grid.Column="1"
                        Value="{Binding Rating}" />
                    <TextBox
                        Grid.Row="3"
                        toolkit:Sizing.Size="lg"
                        Text="Large" />
                    <local:RatingInput
                        Grid.Row="3"
                        Grid.Column="1"
                        toolkit:Sizing.Size="lg"
                        Value="{Binding Rating}" />
                </Grid>
            </c:CodeExample>

            <c:CodeExample
                Title="Validation"
                Code="{Binding ValidationCode}"
                Description="Optional: a Validation.HasError trigger turns the border red, and ValidationErrorTemplate adds the corner badge listing the errors. Give a star to clear it. The second input sets Validation.ErrorTemplate to {x:Null}: no badge, only the red border.">
                <StackPanel
                    Width="200"
                    HorizontalAlignment="Left"
                    toolkit:Spacing.Gap="12">
                    <local:RatingInput Value="{Binding RequiredRating}" />
                    <local:RatingInput Validation.ErrorTemplate="{x:Null}" Value="{Binding RequiredRating}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Embedded buttons"
                Code="{Binding EmbeddedCode}"
                Description="Optional: buttons inside the input use EmbeddedButton, a transparent square of HeightEmbedded, centred in the height of every size. Here the stars and the clear button, which shows once a star is given.">
                <local:RatingInput
                    Width="200"
                    HorizontalAlignment="Left"
                    Maximum="5"
                    Value="{Binding Rating}" />
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
