<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.Toolkit"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <!--  A StaticResource only sees this dictionary and what it merges: bring EmbeddedButton in.  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="RatingInputTemplate" TargetType="{x:Type local:RatingInput}">
        <Grid>
            <!--  The surface: background and border come from the control, so the style (and its triggers) drive them.  -->
            <Border
                x:Name="Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}" />

            <!--
                The content sits over the surface, inside Padding. The input paddings are sized so that
                an embedded button fills exactly what is left of the smallest height (24 - 2 x 2 = 20).
            -->
            <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl
                    VerticalAlignment="Center"
                    Focusable="False"
                    ItemsSource="{Binding Stars, RelativeSource={RelativeSource TemplatedParent}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RatingStar}">
                            <Button
                                Command="{Binding RateCommand, RelativeSource={RelativeSource AncestorType=local:RatingInput}}"
                                CommandParameter="{Binding Index}"
                                Style="{StaticResource EmbeddedButton}">
                                <fonts:FontIcon x:Name="Icon" Text="{x:Static fonts:LucideFontIcons.Star}" />
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFilled}" Value="False">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.Foreground200Brush}}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    x:Name="ClearButton"
                    Grid.Column="1"
                    Command="{Binding ClearCommand, RelativeSource={RelativeSource TemplatedParent}}"
                    Style="{StaticResource EmbeddedButton}">
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.x}" />
                </Button>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Value" Value="0">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================ Minimum ============================  -->
    <!--  Background, border colour and thickness, and a one-line height: enough to sit next to native inputs.  -->
    <Style x:Key="RatingInputMinimal" TargetType="{x:Type local:RatingInput}">
        <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.BackgroundBrush}}" />
        <Setter Property="Padding" Value="{DynamicResource {x:Static joufflu:Dimensions.InputPaddingMd}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}" />
        <Setter Property="BorderThickness" Value="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}" />
        <Setter Property="Height" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}" />
        <Setter Property="Template" Value="{StaticResource RatingInputTemplate}" />
    </Style>

    <!--  ============================ Complete ============================  -->
    <!--  The minimum, plus states, sizes and padding, and the validation badge.  -->
    <Style x:Key="{x:Type local:RatingInput}" TargetType="{x:Type local:RatingInput}">
        <!--  Minimum  -->
        <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.BackgroundBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}" />
        <Setter Property="BorderThickness" Value="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}" />
        <Setter Property="Height" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}" />

        <!--  Font size and padding, md by default  -->
        <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeMd}}" />
        <Setter Property="Padding" Value="{DynamicResource {x:Static joufflu:Dimensions.InputPaddingMd}}" />

        <!--  The stars take the focus, not the control itself  -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />

        <!--  The badge listing the errors; the red border is the trigger below  -->
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource ValidationErrorTemplate}" />
        <Setter Property="Template" Value="{StaticResource RatingInputTemplate}" />

        <Style.Triggers>
            <!--  States, as the native inputs have them  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.Background100Brush}}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.Border100Brush}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource {x:Static joufflu:Colors.DisabledOpacity}}" />
            </Trigger>
            <!--  After hover and focus, so the error colour wins over them  -->
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
            </Trigger>

            <!--  Size variants (md is the default set above)  -->
            <Trigger Property="toolkit:Sizing.Size" Value="xs">
                <Setter Property="Height" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightXs}}" />
                <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeXs}}" />
                <Setter Property="Padding" Value="{DynamicResource {x:Static joufflu:Dimensions.InputPaddingXs}}" />
            </Trigger>
            <Trigger Property="toolkit:Sizing.Size" Value="sm">
                <Setter Property="Height" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightSm}}" />
                <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeSm}}" />
                <Setter Property="Padding" Value="{DynamicResource {x:Static joufflu:Dimensions.InputPaddingSm}}" />
            </Trigger>
            <Trigger Property="toolkit:Sizing.Size" Value="lg">
                <Setter Property="Height" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightLg}}" />
                <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeLg}}" />
                <Setter Property="Padding" Value="{DynamicResource {x:Static joufflu:Dimensions.InputPaddingLg}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
