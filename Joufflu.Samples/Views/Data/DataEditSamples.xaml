<UserControl
    x:Class="Joufflu.Samples.Views.Data.DataEditSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jata="clr-namespace:Joufflu.Data.Controls;assembly=Joufflu.Data"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Data"
    d:DataContext="{d:DesignInstance Type=vm:DataEditSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Data edit" />

            <c:CodeExample
                Title="Build from scratch"
                Code="{Binding EditCode}"
                Description="DataEdit builds a node freely: add properties and array items of any type, rename keys and set values. A key must be unique within its object.">
                <Grid Height="420" toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <jata:DataEdit Node="{Binding Node}" />
                    <TextBox
                        Grid.Column="1"
                        Height="auto"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding Json}"
                        VerticalScrollBarVisibility="Auto" />

                    <Button Grid.Row="1" Command="{Binding ClearCommand}">Clear</Button>
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Command="{Binding GenerateJsonCommand}"
                        Style="{StaticResource PrimaryButton}">
                        Generate json
                    </Button>
                </Grid>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
