<UserControl
    x:Class="Joufflu.Samples.Views.Data.DataFormSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Joufflu.Data.Controls;assembly=Joufflu.Data"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Data"
    d:DataContext="{d:DesignInstance Type=vm:DataFormSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="Bold"
                Text="Data form"
                TextWrapping="Wrap" />

            <c:CodeExample
                Title="A form from a schema"
                Code="{Binding FormCode}"
                Description="DataForm fills in a node built from a JSON schema as a form : a labelled field per property, with the input and the rules the schema gives (title, description, file picker, text of several lines, range, length, pattern). A field offers to point at a manual value only when one fits it.">
                <Grid Height="520" toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <data:DataForm ManualValues="{Binding ManualValues}" Node="{Binding Node}" />
                    <TextBox
                        Grid.Column="1"
                        Height="auto"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding Json}"
                        VerticalScrollBarVisibility="Auto" />

                    <Button Grid.Row="1" Command="{Binding GenerateCommand}">Reset from schema</Button>
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Command="{Binding GenerateJsonCommand}"
                        Style="{StaticResource PrimaryButton}">
                        Generate json
                    </Button>
                </Grid>
            </c:CodeExample>

            <c:CodeExample
                Title="An array of strings"
                Code="{Binding ArrayCode}"
                Description="An array of plain values shows one editor per item, removed with the button on its right, and adds a new one from the item type of the schema.">
                <Grid Height="320" toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <data:DataForm Node="{Binding ArrayNode}" />
                    <TextBox
                        Grid.Column="1"
                        Height="auto"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding ArrayJson}"
                        VerticalScrollBarVisibility="Auto" />

                    <Button Grid.Row="1" Command="{Binding GenerateArrayCommand}">Reset</Button>
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Command="{Binding GenerateArrayJsonCommand}"
                        Style="{StaticResource PrimaryButton}">
                        Generate json
                    </Button>
                </Grid>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
