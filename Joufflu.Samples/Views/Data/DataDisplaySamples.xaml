<UserControl
    x:Class="Joufflu.Samples.Views.Data.DataDisplaySamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Joufflu.Data.Controls;assembly=Joufflu.Data"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Data"
    d:DataContext="{d:DesignInstance Type=vm:DataDisplaySamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock toolkit:Sizing.Size="xl" FontWeight="Bold" TextWrapping="Wrap" Text="Data display" />

            <c:CodeExample
                Title="Show a node"
                Code="{Binding DisplayCode}"
                Description="DataDisplay shows a node read only: the key, the type and the value of each node. Null reads apart from a text, a forced value is flagged with a feather.">
                <Grid Height="420" toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <data:DataDisplay Node="{Binding Node}" />
                    <TextBox
                        Grid.Column="1"
                        Height="auto"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding Json, Mode=OneWay}"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </c:CodeExample>

            <c:CodeExample
                Title="Show a JToken"
                Code="{Binding TokenCode}"
                Description="A JToken bound to Node is read as ToDataNode does, so a plain value (here a string) is shown without building a node first.">
                <data:DataDisplay Node="{Binding Token}" />
            </c:CodeExample>

            <c:CodeExample
                Title="Open a file"
                Code="{Binding FileCode}"
                Description="ReadDataNode builds the node straight from a JsonReader, so a large file is never held as tokens too. The tree only builds the rows in view: files of millions of nodes scroll as fast as small ones.">
                <Grid Height="420" toolkit:Spacing.Gap="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <inputs:FilePicker FilePath="{Binding FilePath, Mode=TwoWay}" Options="{Binding JsonFileOptions}" />
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding FileStatus}"
                        TextTrimming="CharacterEllipsis" />
                    <data:DataDisplay Grid.Row="2" Node="{Binding FileNode}" />
                </Grid>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
