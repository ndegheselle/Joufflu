<UserControl
    x:Class="Joufflu.Samples.Views.Data.DataDisplaySamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jata="clr-namespace:Joufflu.Data.Controls;assembly=Joufflu.Data"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Data"
    d:DataContext="{d:DesignInstance Type=vm:DataDisplaySamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Data display" />

            <c:CodeExample
                Title="Show a node"
                Code="{Binding DisplayCode}"
                Description="DataDisplay shows a node read only: the key, the type and the value of each node. Null reads apart from a text, a forced value is flagged with a feather.">
                <Grid Height="420" toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <jata:DataDisplay Node="{Binding Node}" />
                    <TextBox
                        Grid.Column="1"
                        Height="auto"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding Json, Mode=OneWay}"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
