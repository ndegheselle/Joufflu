<UserControl
    x:Class="Joufflu.Samples.Views.Feedback.SpinnerSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:feedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Feedback"
    d:DataContext="{d:DesignInstance Type=vm:SpinnerSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel joufflu:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">

            <TextBlock Style="{StaticResource H1}" Text="Spinner" />
            <c:CodeExample
                Title="Loading indicator"
                Code="{Binding Code}"
                Description="An indeterminate loading indicator. Color comes from Foreground, diameter from Sizing.Size.">
                <StackPanel
                    VerticalAlignment="Center"
                    joufflu:Spacing.Gap="16,0"
                    Orientation="Horizontal">
                    <feedback:Spinner joufflu:Sizing.Size="xs" />
                    <feedback:Spinner joufflu:Sizing.Size="sm" />
                    <feedback:Spinner joufflu:Sizing.Size="md" />
                    <feedback:Spinner joufflu:Sizing.Size="lg" />
                    <feedback:Spinner joufflu:Sizing.Size="lg" Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
