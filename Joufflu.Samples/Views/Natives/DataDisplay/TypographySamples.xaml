<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataDisplay.TypographySamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataDisplay"
    d:DataContext="{d:DesignInstance Type=vm:TypographySamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock toolkit:Sizing.Size="xl" FontWeight="Bold" TextWrapping="Wrap" Text="Typography" />

            <c:CodeExample
                Title="Sizes"
                Code="{Binding SizesCode}"
                Description="A TextBlock takes its font size from Sizing.Size, like the controls: xs to xl read the FontSize tokens, md keeps the inherited body size. Sizing.Size is inherited, so a panel set to a size sizes the text inside it too.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <TextBlock toolkit:Sizing.Size="xl" Text="xl — The quick brown fox" />
                    <TextBlock toolkit:Sizing.Size="lg" Text="lg — The quick brown fox" />
                    <TextBlock Text="md — The quick brown fox" />
                    <TextBlock toolkit:Sizing.Size="sm" Text="sm — The quick brown fox" />
                    <TextBlock toolkit:Sizing.Size="xs" Text="xs — The quick brown fox" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Headings"
                Code="{Binding HeadingsCode}"
                Description="A heading is a size and a weight: xl for a page title, lg for a section, the body size for a minor heading.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <TextBlock toolkit:Sizing.Size="xl" FontWeight="Bold" Text="Page title" />
                    <TextBlock toolkit:Sizing.Size="lg" FontWeight="SemiBold" Text="Section" />
                    <TextBlock FontWeight="SemiBold" Text="Minor heading" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Muted text"
                Code="{Binding MutedCode}"
                Description="Secondary text (hints, descriptions, captions) is dimmed with the MutedOpacity token rather than given a colour of its own, so it follows whatever foreground it sits in.">
                <StackPanel toolkit:Spacing.Gap="8">
                    <TextBlock Text="Default — the standard body text." />
                    <TextBlock
                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                        Text="Muted — secondary text, dimmed to sit quietly next to primary content."
                        TextWrapping="Wrap" />
                    <TextBlock
                        toolkit:Sizing.Size="xs"
                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                        Text="A muted caption: fine print, footnotes."
                        TextWrapping="Wrap" />
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
