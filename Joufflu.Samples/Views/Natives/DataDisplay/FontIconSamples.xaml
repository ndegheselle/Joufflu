<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataDisplay.FontIconSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataDisplay"
    d:DataContext="{d:DesignInstance Type=vm:FontIconSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="Bold"
                TextWrapping="Wrap"
                Text="Font icon" />

            <c:CodeExample
                Title="Glyphs"
                Code="{Binding Code}"
                Description="A glyph of the embedded Lucide icon font, set from a LucideFontIcons constant. FontIcon is a TextBlock, so it aligns like text and goes anywhere content does.">
                <WrapPanel toolkit:Spacing.Gap="12,0">
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Home}" />
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Bell}" />
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Settings}" />
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Sizes"
                Code="{Binding SizesCode}"
                Description="The size follows the inherited Sizing.Size (xs to xl), so an icon scales with the control or the panel it sits in. md is the default.">
                <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="12,0">
                    <fonts:FontIcon VerticalAlignment="Center" toolkit:Sizing.Size="xs" Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    <fonts:FontIcon VerticalAlignment="Center" toolkit:Sizing.Size="sm" Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    <fonts:FontIcon VerticalAlignment="Center" toolkit:Sizing.Size="md" Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    <fonts:FontIcon VerticalAlignment="Center" toolkit:Sizing.Size="lg" Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Colour"
                Code="{Binding ColourCode}"
                Description="Foreground is a normal TextBlock property: point it at a design-system brush to give an icon a semantic hue.">
                <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="12,0">
                    <fonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    <fonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.SuccessBrush}}" Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    <fonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    <fonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Chevron"
                Code="{Binding ChevronCode}"
                Description="The chevron of a header that opens content, its glyph following IsExpanded. Leading (before the header, as in a tree) points right then down, Trailing (after it, as in an expander) points down then up. ChevronToggleButton is the toggle of a tree row built on it.">
                <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="12,0">
                    <ToggleButton x:Name="ChevronToggle" Style="{StaticResource ChevronToggleButton}" />
                    <fonts:Chevron IsExpanded="{Binding IsChecked, ElementName=ChevronToggle}" Placement="Trailing" />
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
