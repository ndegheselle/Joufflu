<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataInput.CalendarSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataInput"
    d:DataContext="{d:DesignInstance Type=vm:CalendarSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="Bold"
                TextWrapping="Wrap"
                Text="Calendar" />

            <c:CodeExample
                Title="Inline calendar"
                Code="{Binding Code}"
                Description="The full month view shown inline. Bind SelectedDate to the view model.">
                <StackPanel toolkit:Spacing.Gap="8">
                    <Calendar HorizontalAlignment="Left" SelectedDate="{Binding SelectedDate}" />
                    <TextBlock Text="{Binding SelectedDate, StringFormat={}Selected: {0:D}}" />
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
