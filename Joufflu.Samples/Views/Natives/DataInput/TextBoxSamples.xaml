<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataInput.TextBoxSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataInput"
    d:DataContext="{d:DesignInstance Type=vm:TextBoxSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="Bold"
                Text="Text box"
                TextWrapping="Wrap" />

            <c:CodeExample
                Title="Text input"
                Code="{Binding TextCode}"
                Description="A standard TextBox bound to the view model.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox IsEnabled="False" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Sizes"
                Code="{Binding SizesCode}"
                Description="Height, font size and padding follow the inherited Sizing.Size.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <TextBox toolkit:Sizing.Size="sm" Text="Small" />
                    <TextBox Text="Medium" />
                    <TextBox toolkit:Sizing.Size="lg" Text="Large" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Validation"
                Code="{Binding ValidationCode}"
                Description="Binding errors turn the input's border red, and ValidationErrorTemplate adds a corner badge whose tooltip lists them. Type a username to clear them.">
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            </c:CodeExample>

            <c:CodeExample
                Title="Password &amp; multi-line"
                Code="{Binding OtherCode}"
                Description="PasswordBox shares the TextBox styling. The MultilineTextBox style makes a TextBox multi-line: it accepts Return and takes the height it is given.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <PasswordBox Password="secret" />
                    <TextBox
                        Height="70"
                        Style="{StaticResource MultilineTextBox}"
                        Text="Multi-line&#x0a;text box" />
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
