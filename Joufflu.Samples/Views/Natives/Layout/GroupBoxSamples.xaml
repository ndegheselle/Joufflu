<UserControl
    x:Class="Joufflu.Samples.Views.Natives.Layout.GroupBoxSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="Bold"
                TextWrapping="Wrap"
                Text="Group box" />

            <c:CodeExample
                Title="Grouped content"
                
                Description="A titled frame around a set of related controls."
                Code="&lt;GroupBox Header=&quot;Account&quot;&gt;&#x0a;    ...&#x0a;&lt;/GroupBox&gt;">
                <GroupBox Header="Account">
                    <StackPanel toolkit:Spacing.Gap="8">
                        <TextBox Text="Username" />
                        <CheckBox Content="Remember me" IsChecked="True" />
                    </StackPanel>
                </GroupBox>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
