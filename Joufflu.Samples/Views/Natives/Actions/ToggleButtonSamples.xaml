<UserControl
    x:Class="Joufflu.Samples.Views.Natives.Actions.ToggleButtonSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.Actions"
    d:DataContext="{d:DesignInstance Type=vm:ToggleButtonSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock
                Style="{StaticResource H1}"
                Text="Toggle button" />

            <c:CodeExample
                Title="Variants"
                Code="{Binding VariantsCode}"
                Description="Toggle buttons mirror the button variants but stay pressed when checked. Toggle one on to see its checked state.">
                <WrapPanel toolkit:Spacing.Gap="8,0">
                    <ToggleButton IsChecked="True">Default</ToggleButton>
                    <ToggleButton Style="{StaticResource PrimaryToggleButton}">Primary</ToggleButton>
                    <ToggleButton Style="{StaticResource SecondaryToggleButton}">Secondary</ToggleButton>
                    <ToggleButton Style="{StaticResource GhostToggleButton}">Ghost</ToggleButton>
                    <ToggleButton Style="{StaticResource SuccessToggleButton}">Success</ToggleButton>
                    <ToggleButton Style="{StaticResource InfoToggleButton}">Info</ToggleButton>
                    <ToggleButton Style="{StaticResource WarningToggleButton}">Warning</ToggleButton>
                    <ToggleButton Style="{StaticResource DangerToggleButton}">Danger</ToggleButton>
                    <ToggleButton IsEnabled="False">Disabled</ToggleButton>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Soft"
                Code="{Binding SoftCode}"
                Description="A tinted background with the semantic hue as text; checking it turns it solid.">
                <WrapPanel toolkit:Spacing.Gap="8,0">
                    <ToggleButton Style="{StaticResource SoftPrimaryToggleButton}">Primary</ToggleButton>
                    <ToggleButton Style="{StaticResource SoftSecondaryToggleButton}">Secondary</ToggleButton>
                    <ToggleButton Style="{StaticResource SoftSuccessToggleButton}">Success</ToggleButton>
                    <ToggleButton Style="{StaticResource SoftInfoToggleButton}">Info</ToggleButton>
                    <ToggleButton Style="{StaticResource SoftWarningToggleButton}">Warning</ToggleButton>
                    <ToggleButton Style="{StaticResource SoftDangerToggleButton}">Danger</ToggleButton>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Outline"
                Code="{Binding OutlineCode}"
                Description="A coloured border and text over a transparent fill; checking it turns it solid.">
                <WrapPanel toolkit:Spacing.Gap="8,0">
                    <ToggleButton Style="{StaticResource OutlinePrimaryToggleButton}">Primary</ToggleButton>
                    <ToggleButton Style="{StaticResource OutlineSecondaryToggleButton}">Secondary</ToggleButton>
                    <ToggleButton Style="{StaticResource OutlineSuccessToggleButton}">Success</ToggleButton>
                    <ToggleButton Style="{StaticResource OutlineInfoToggleButton}">Info</ToggleButton>
                    <ToggleButton Style="{StaticResource OutlineWarningToggleButton}">Warning</ToggleButton>
                    <ToggleButton Style="{StaticResource OutlineDangerToggleButton}">Danger</ToggleButton>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Icon toggle buttons"
                Code="{Binding IconCode}"
                Description="IconToggleButton is a ready-made square toggle for a single icon.">
                <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="8,0">
                    <ToggleButton Style="{StaticResource IconToggleButton}">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Bell}" />
                    </ToggleButton>
                    <ToggleButton toolkit:Sizing.IsSquare="True" Style="{StaticResource PrimaryToggleButton}">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Settings}" />
                    </ToggleButton>
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Sizes"
                Code="{Binding SizesCode}"
                Description="Toggle buttons scale through the inherited Sizing.Size attached property.">
                <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="8,0">
                    <ToggleButton VerticalAlignment="Center" toolkit:Sizing.Size="xs">XS</ToggleButton>
                    <ToggleButton VerticalAlignment="Center" toolkit:Sizing.Size="sm">SM</ToggleButton>
                    <ToggleButton VerticalAlignment="Center" toolkit:Sizing.Size="md">MD</ToggleButton>
                    <ToggleButton VerticalAlignment="Center" toolkit:Sizing.Size="lg">LG</ToggleButton>
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
