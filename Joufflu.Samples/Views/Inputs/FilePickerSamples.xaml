<UserControl
    x:Class="Joufflu.Samples.Views.Inputs.FilePickerSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Inputs"
    d:DataContext="{d:DesignInstance Type=vm:FilePickerSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="Bold"
                Text="File picker"
                TextWrapping="Wrap" />
            <c:CodeExample
                Title="FilePicker"
                Code="{Binding FilePickerCode}"
                Description="Selects a file through the system dialog and exposes the chosen path, with a clear button. The path can also be typed.">
                <inputs:FilePicker
                    Width="360"
                    HorizontalAlignment="Left"
                    FilePath="{Binding FilePath, Mode=TwoWay}" />
            </c:CodeExample>
            <c:CodeExample
                Title="File types"
                Code="{Binding FileTypesCode}"
                Description="Options takes a FilePickerOptions: Filter lists the file types the dialog offers, in OpenFileDialog.Filter syntax, and DefaultExtension is the extension it appends to a typed name.">
                <inputs:FilePicker
                    Width="360"
                    HorizontalAlignment="Left"
                    FilePath="{Binding ImagePath}"
                    Options="{Binding ImageOptions}" />
            </c:CodeExample>
            <c:CodeExample
                Title="Validation"
                Code="{Binding ValidationCode}"
                Description="Binding errors (here from an ObservableValidator) turn the input's border red, and ValidationErrorTemplate adds a corner badge whose tooltip lists them. Choose a file to clear it. The second input sets Validation.ErrorTemplate to {x:Null}: no badge, only the red border.">
                <StackPanel
                    Width="360"
                    HorizontalAlignment="Left"
                    toolkit:Spacing.Gap="12">
                    <inputs:FilePicker FilePath="{Binding RequiredFilePath, Mode=TwoWay}" />
                    <inputs:FilePicker FilePath="{Binding RequiredFilePath, Mode=TwoWay}" Validation.ErrorTemplate="{x:Null}" />
                </StackPanel>
            </c:CodeExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
