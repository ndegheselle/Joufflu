<UserControl
    x:Class="Joufflu.Samples.Views.Inputs.DropdownSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.Inputs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:DropdownSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel joufflu:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Dropdown" />

            <c:CodeExample
                Title="Dropdown"
                Code="{Binding Code}"
                Description="A toggle button opening a themed popup that holds any content. Header is the button, the control's content is the popup.">
                <inputs:Dropdown Header="Actions">
                    <StackPanel joufflu:Spacing.Gap="4">
                        <Button Content="Rename" Style="{StaticResource GhostButton}" />
                        <Button Content="Duplicate" Style="{StaticResource GhostButton}" />
                        <Button Content="Delete" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </inputs:Dropdown>
            </c:CodeExample>

            <c:CodeExample
                Title="Popup placement"
                Code="{Binding PlacementCode}"
                Description="PopupPlacement anchors a corner of the popup to the matching corner of the button. BottomRight right aligns it, TopLeft and TopRight open it upward — useful near the bottom of the window. HorizontalOffset and VerticalOffset add to that placement.">
                <WrapPanel joufflu:Spacing.Gap="8,8">
                    <inputs:Dropdown Header="BottomLeft" PopupPlacement="BottomLeft">
                        <TextBlock Text="Opens down, left aligned." />
                    </inputs:Dropdown>
                    <inputs:Dropdown Header="BottomRight" PopupPlacement="BottomRight">
                        <TextBlock Text="Opens down, right aligned." />
                    </inputs:Dropdown>
                    <inputs:Dropdown Header="TopLeft" PopupPlacement="TopLeft">
                        <TextBlock Text="Opens up, left aligned." />
                    </inputs:Dropdown>
                    <inputs:Dropdown Header="TopRight" PopupPlacement="TopRight">
                        <TextBlock Text="Opens up, right aligned." />
                    </inputs:Dropdown>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Button style"
                Code="{Binding StyleCode}"
                Description="ButtonStyle restyles the toggle button — any ToggleButton style — and Header takes arbitrary content, an icon included. PopupStyle does the same for the hosting Popup.">
                <inputs:Dropdown ButtonStyle="{StaticResource IconToggleButton}" PopupPlacement="BottomRight">
                    <inputs:Dropdown.Header>
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.EllipsisVertical}" />
                    </inputs:Dropdown.Header>
                    <TextBlock Text="An icon only dropdown." />
                </inputs:Dropdown>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
