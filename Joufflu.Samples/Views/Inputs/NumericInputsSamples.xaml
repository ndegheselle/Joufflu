<UserControl
    x:Class="Joufflu.Samples.Views.Inputs.NumericInputsSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:format="clr-namespace:Joufflu.Inputs.Controls.Format;assembly=Joufflu.Inputs"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Inputs"
    d:DataContext="{d:DesignInstance Type=vm:NumericInputsSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Numeric &amp; format inputs" />

            <c:CodeExample
                Title="NumericUpDown"
                Code="{Binding NumericCode}"
                Description="Selects a whole number. Built on FormatTextBox with the numeric format, clear and increment/decrement buttons included.">
                <StackPanel toolkit:Spacing.Gap="12,0" Orientation="Horizontal">
                    <inputs:NumericUpDown Width="180" Value="{Binding NumericValue, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding NumericValue, StringFormat='Value: {0}'}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="DecimalUpDown"
                Code="{Binding DecimalCode}"
                Description="Selects a double / decimal value using the decimal format.">
                <StackPanel toolkit:Spacing.Gap="12,0" Orientation="Horizontal">
                    <inputs:DecimalUpDown Width="180" Value="{Binding DecimalValue, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding DecimalValue, StringFormat='Value: {0}'}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="TimeSpanPicker"
                Code="{Binding TimeSpanCode}"
                Description="Selects a TimeSpan through a days/hours/minutes/seconds format.">
                <StackPanel toolkit:Spacing.Gap="12,0" Orientation="Horizontal">
                    <inputs:TimeSpanPicker Width="180" Value="{Binding Duration, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Duration, StringFormat='Value: {0}'}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="FormatTextBox"
                Code="{Binding FormatCode}"
                Description="The base input: groups the user types into, with literal text between them, each group read into its own value and navigated with Tab / arrows.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <format:FormatTextBox toolkit:Sizing.Size="xs">
                        <format:IntegerGroup Max="23" StringFormat="00" />
                        <format:FormatLiteral Text="h " />
                        <format:IntegerGroup Max="59" StringFormat="00" />
                        <format:FormatLiteral Text="m" />
                    </format:FormatTextBox>
                    <format:FormatTextBox toolkit:Sizing.Size="sm">
                        <format:IntegerGroup Max="23" StringFormat="00" />
                        <format:FormatLiteral Text="h " />
                        <format:IntegerGroup Max="59" StringFormat="00" />
                        <format:FormatLiteral Text="m" />
                    </format:FormatTextBox>
                    <format:FormatTextBox>
                        <format:IntegerGroup Max="23" StringFormat="00" />
                        <format:FormatLiteral Text="h " />
                        <format:IntegerGroup Max="59" StringFormat="00" />
                        <format:FormatLiteral Text="m" />
                    </format:FormatTextBox>
                    <format:FormatTextBox toolkit:Sizing.Size="lg">
                        <format:IntegerGroup Max="23" StringFormat="00" />
                        <format:FormatLiteral Text="h " />
                        <format:IntegerGroup Max="59" StringFormat="00" />
                        <format:FormatLiteral Text="m" />
                    </format:FormatTextBox>
                </StackPanel>
            </c:CodeExample>
            <c:CodeExample
                Title="Validation"
                Code="{Binding ValidationCode}"
                Description="Binding errors (here from an ObservableValidator) turn the input's border red, and ValidationErrorTemplate adds a corner badge whose tooltip lists them. Bring each value in range to clear it: a rating from 1 to 10, a ratio from 0 to 1, at most one hour. The last input sets Validation.ErrorTemplate to {x:Null}: no badge, only the red border.">
                <StackPanel
                    Width="360"
                    HorizontalAlignment="Left"
                    toolkit:Spacing.Gap="12">
                    <inputs:NumericUpDown Value="{Binding Rating, Mode=TwoWay}" />
                    <inputs:DecimalUpDown Value="{Binding Ratio, Mode=TwoWay}" />
                    <inputs:TimeSpanPicker Value="{Binding ShortDuration, Mode=TwoWay}" />
                    <inputs:NumericUpDown Validation.ErrorTemplate="{x:Null}" Value="{Binding Rating, Mode=TwoWay}" />
                </StackPanel>
            </c:CodeExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
