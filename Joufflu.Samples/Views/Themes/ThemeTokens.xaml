<UserControl
    x:Class="Joufflu.Samples.Views.Themes.ThemeTokens"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:conv="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Themes"
    d:DataContext="{d:DesignInstance Type=vm:ThemeTokensViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="NullToVis" />

        <!--  A tile of an accent family, and the key name printed under it  -->
        <Style x:Key="AccentSwatch" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="34" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}" />
            <Setter Property="BorderThickness" Value="{DynamicResource {x:Static joufflu:Dimensions.DisplayThickness}}" />
            <Setter Property="CornerRadius" Value="{DynamicResource {x:Static joufflu:Dimensions.DisplayRadius}}" />
        </Style>

        <Style x:Key="AccentCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeXs}}" />
            <Setter Property="Opacity" Value="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}" />
        </Style>

        <!--  One documented key: swatch (colours only) + name + what it is used for  -->
        <DataTemplate x:Key="TokenEntryTemplate" DataType="{x:Type vm:TokenEntry}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  The key is bound, so the swatch needs a pushed resource reference, not a DynamicResource  -->
                <Border
                    Width="18"
                    Height="18"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    c:ResourceSwatch.BackgroundKey="{Binding Swatch}"
                    BorderBrush="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}"
                    BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.DisplayThickness}}"
                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.DisplayRadius}}"
                    Visibility="{Binding Swatch, Converter={StaticResource NullToVis}}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Text="{Binding Key}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                    Text="{Binding Usage}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!--  One accent family: its three keys drawn side by side, then what the family is for  -->
        <DataTemplate x:Key="AccentEntryTemplate" DataType="{x:Type vm:AccentEntry}">
            <Border Style="{StaticResource Card}">
                <Grid toolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  The fill, with "Aa" over it in the content colour: the pairing the family exists for  -->
                    <StackPanel toolkit:Spacing.Gap="0,3">
                        <Border
                            HorizontalAlignment="Left"
                            c:ResourceSwatch.BackgroundKey="{Binding Fill}"
                            Style="{StaticResource AccentSwatch}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                c:ResourceSwatch.ForegroundKey="{Binding Foreground}"
                                Text="Aa" />
                        </Border>
                        <TextBlock Style="{StaticResource AccentCaption}" Text="{Binding Name}" />
                    </StackPanel>

                    <!--  The same fill as it is drawn while hovered or pressed  -->
                    <StackPanel Grid.Column="1" toolkit:Spacing.Gap="0,3">
                        <Border
                            HorizontalAlignment="Left"
                            c:ResourceSwatch.BackgroundKey="{Binding Hover}"
                            Style="{StaticResource AccentSwatch}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                c:ResourceSwatch.ForegroundKey="{Binding Foreground}"
                                Text="Aa" />
                        </Border>
                        <TextBlock Style="{StaticResource AccentCaption}" Text="{Binding Name, StringFormat={}{0}Interaction}" />
                    </StackPanel>

                    <!--  The content colour on its own  -->
                    <StackPanel Grid.Column="2" toolkit:Spacing.Gap="0,3">
                        <Border
                            HorizontalAlignment="Left"
                            c:ResourceSwatch.BackgroundKey="{Binding Foreground}"
                            Style="{StaticResource AccentSwatch}" />
                        <TextBlock Style="{StaticResource AccentCaption}" Text="{Binding Name, StringFormat={}{0}Foreground}" />
                    </StackPanel>

                    <!--  The soft tint, with "Aa" in the fill colour as a soft button draws it; set apart as it is a brush only  -->
                    <StackPanel Grid.Column="3" toolkit:Spacing.Gap="0,3">
                        <Border
                            HorizontalAlignment="Left"
                            c:ResourceSwatch.BackgroundKey="{Binding Soft}"
                            Style="{StaticResource AccentSwatch}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                c:ResourceSwatch.ForegroundKey="{Binding Fill}"
                                Text="Aa" />
                        </Border>
                        <TextBlock Style="{StaticResource AccentCaption}" Text="{Binding Name, StringFormat={}{0}Soft}" />
                    </StackPanel>

                    <!--  The same tint while hovered  -->
                    <StackPanel Grid.Column="4" toolkit:Spacing.Gap="0,3">
                        <Border
                            HorizontalAlignment="Left"
                            c:ResourceSwatch.BackgroundKey="{Binding SoftInteraction}"
                            Style="{StaticResource AccentSwatch}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                c:ResourceSwatch.ForegroundKey="{Binding Fill}"
                                Text="Aa" />
                        </Border>
                        <TextBlock Style="{StaticResource AccentCaption}" Text="{Binding Name, StringFormat={}{0}SoftInteraction}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                        Text="{Binding Usage}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--  One family of keys: title, why it exists, then the keys themselves  -->
        <DataTemplate x:Key="TokenGroupTemplate" DataType="{x:Type vm:TokenGroup}">
            <Border Style="{StaticResource Card}">
                <StackPanel toolkit:Spacing.Gap="0,6">
                    <TextBlock
                        toolkit:Sizing.Size="lg"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemTemplate="{StaticResource TokenEntryTemplate}" ItemsSource="{Binding Entries}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="Bold"
                Text="Design tokens"
                TextWrapping="Wrap" />
            <TextBlock
                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                Text="A theme is a collection of the keys below. Every control style reads them through DynamicResource, so a theme only has to redefine what it wants to change - anything it leaves out keeps the built-in value."
                TextWrapping="Wrap" />

            <c:CodeExample
                Title="Reading a token"
                Code="{Binding UsageCode}"
                Description="Keys are ComponentResourceKey statics, so they are typed rather than stringly named — a renamed key breaks the build instead of silently falling back at runtime." />

            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="SemiBold"
                Text="Colors"
                TextWrapping="Wrap" />
            <TextBlock
                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                Text="Each colour exists twice: joufflu:Colors.XColor holds the Color, joufflu:Brushes.XBrush the SolidColorBrush built from it. Use the brush in the UI; the colour is there for gradients, animations and anything needing the raw value."
                TextWrapping="Wrap" />
            <ItemsControl ItemTemplate="{StaticResource TokenGroupTemplate}" ItemsSource="{Binding ColorTokens}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel toolkit:Spacing.Gap="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock
                toolkit:Sizing.Size="lg"
                FontWeight="SemiBold"
                Text="Accents"
                TextWrapping="Wrap" />
            <TextBlock
                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                Text="Six semantic families sharing one shape: the fill, the same fill for hover and pressed, and the content drawn on top of both. Only the fill and the content are colours a theme defines. The hover is the fill mixed 10% toward its own content colour, so it stays readable under the same text, and the soft tint (soft buttons, selected rows) and its hover are the fill at a low opacity, drawn with the fill as text."
                TextWrapping="Wrap" />
            <ItemsControl ItemTemplate="{StaticResource AccentEntryTemplate}" ItemsSource="{Binding AccentTokens}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel toolkit:Spacing.Gap="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl ItemTemplate="{StaticResource TokenGroupTemplate}" ItemsSource="{Binding StateTokens}" />

            <TextBlock
                toolkit:Sizing.Size="xl"
                FontWeight="SemiBold"
                Text="Dimensions"
                TextWrapping="Wrap" />
            <TextBlock
                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                Text="joufflu:Dimensions holds the metrics. The values in parentheses are the built-in defaults — the Customize theme page edits them live, which is why styles must read them dynamically rather than baking a Thickness at parse time."
                TextWrapping="Wrap" />
            <ItemsControl ItemTemplate="{StaticResource TokenGroupTemplate}" ItemsSource="{Binding DimensionTokens}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel toolkit:Spacing.Gap="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
