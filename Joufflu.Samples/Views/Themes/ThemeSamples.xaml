<UserControl
    x:Class="Joufflu.Samples.Views.Themes.ThemeSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:controls="clr-namespace:Joufflu.Controls;assembly=Joufflu"
    xmlns:conv="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:themes="clr-namespace:Joufflu.Themes;assembly=Joufflu"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Themes"
    d:DataContext="{d:DesignInstance Type=vm:ThemeSamplesViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:EnumMatchToBooleanConverter x:Key="EnumMatch" />
    </UserControl.Resources>
    <ScrollViewer Padding="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
            <TextBlock toolkit:Sizing.Size="xl" FontWeight="Bold" TextWrapping="Wrap" Text="Theme" />
            <TextBlock
                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                Text="System / Light / Dark, applied by swapping the active theme resource dictionary at runtime."
                TextWrapping="Wrap" />

            <c:CodeExample
                Title="App setup"
                Code="{Binding SetupCode}"
                Description="Merge only the control styles in App.xaml. Initialize() inserts the matching Light/Dark dictionary right after them at runtime — no theme dictionary is hardcoded." />

            <c:CodeExample
                Title="ThemeManager"
                Code="{Binding ManagerCode}"
                Description="The manager owns the active theme. Initialize it once at startup, then set Theme from anywhere. When Theme is System, it reads the Windows theme and keeps following it while the app runs." />

            <c:CodeExample
                Title="Theme switcher"
                Code="{Binding SwitcherCode}"
                Description="Plain RadioButtons bound to ThemeManager. Pick a theme by name and the whole gallery re-themes live; this app remembers the choice across launches itself. 'Ocean' is a custom theme this app registered at startup — it sits alongside the built-ins.">
                <StackPanel toolkit:Spacing.Gap="4">

                    <RadioButton IsChecked="{Binding Theme, Source={x:Static themes:ThemeManager.Instance}, Converter={StaticResource EnumMatch}, ConverterParameter=System, Mode=TwoWay}" ToolTip="Follow the system theme">
                        <StackPanel toolkit:Spacing.Gap="6,0" Orientation="Horizontal">
                            <fonts:FontIcon VerticalAlignment="Center" Text="{x:Static fonts:LucideFontIcons.Monitor}" />
                            <TextBlock VerticalAlignment="Center" Text="System" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton IsChecked="{Binding Theme, Source={x:Static themes:ThemeManager.Instance}, Converter={StaticResource EnumMatch}, ConverterParameter=Light, Mode=TwoWay}" ToolTip="Use the light theme">
                        <StackPanel toolkit:Spacing.Gap="6,0" Orientation="Horizontal">
                            <fonts:FontIcon VerticalAlignment="Center" Text="{x:Static fonts:LucideFontIcons.Sun}" />
                            <TextBlock VerticalAlignment="Center" Text="Light" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton IsChecked="{Binding Theme, Source={x:Static themes:ThemeManager.Instance}, Converter={StaticResource EnumMatch}, ConverterParameter=Dark, Mode=TwoWay}" ToolTip="Use the dark theme">
                        <StackPanel toolkit:Spacing.Gap="6,0" Orientation="Horizontal">
                            <fonts:FontIcon VerticalAlignment="Center" Text="{x:Static fonts:LucideFontIcons.Moon}" />
                            <TextBlock VerticalAlignment="Center" Text="Dark" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton IsChecked="{Binding Theme, Source={x:Static themes:ThemeManager.Instance}, Converter={StaticResource EnumMatch}, ConverterParameter=Ocean, Mode=TwoWay}" ToolTip="Use the custom Ocean theme">
                        <StackPanel toolkit:Spacing.Gap="6,0" Orientation="Horizontal">
                            <fonts:FontIcon VerticalAlignment="Center" Text="{x:Static fonts:LucideFontIcons.Palette}" />
                            <TextBlock VerticalAlignment="Center" Text="Ocean (custom)" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
