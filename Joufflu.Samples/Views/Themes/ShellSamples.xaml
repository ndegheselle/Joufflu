<UserControl
    x:Class="Joufflu.Samples.Views.Themes.ShellSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:controls="clr-namespace:Joufflu.Controls;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:nav="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Application shell" />

            <TextBlock
                Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                Text="These styles shape the whole window rather than a control on a page — this gallery window itself is the live example. The snippets below show how to wire them up."
                TextWrapping="Wrap" />

            <c:CodeExample
                Title="Window"
                Code="&lt;Window ...&gt;&#x0a;    &lt;!-- inherits the themed Window style automatically --&gt;&#x0a;&lt;/Window&gt;"
                Description="The default Window style themes a standard WPF window (background, foreground and native chrome) to match the design system.">
                <TextBlock Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="Applied implicitly to every Window." />
            </c:CodeExample>

            <c:CodeExample
                Title="ThemedWindow"
                Code="&lt;controls:ThemedWindow xmlns:controls=&quot;clr-namespace:Joufflu.Controls;assembly=Joufflu&quot;&#x0a;                       Title=&quot;My app&quot;&gt;&#x0a;    ...&#x0a;&lt;/controls:ThemedWindow&gt;"
                Description="ThemedWindow is a custom window with a fully styled title bar and caption buttons. This gallery's MainWindow derives from it.">
                <TextBlock Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="You are looking at a ThemedWindow right now." />
            </c:CodeExample>

            <c:CodeExample
                Title="AppIcon"
                Code="&lt;controls:ThemedWindow ...&gt;&#x0a;    &lt;controls:ThemedWindow.TitleBarContent&gt;&#x0a;        &lt;controls:AppIcon Margin=&quot;5,0,0,0&quot; /&gt;&#x0a;    &lt;/controls:ThemedWindow.TitleBarContent&gt;&#x0a;&lt;/controls:ThemedWindow&gt;"
                Description="The title bar shows no icon by default. AppIcon shows the application icon, or the Source it is given; put it in TitleBarContent to bring it back. A click opens the system menu and a double click closes the window.">
                <controls:AppIcon HorizontalAlignment="Left" IsHitTestVisible="False" />
            </c:CodeExample>

            <c:CodeExample
                Title="AllowContentOverTitleBar"
                Code="&lt;controls:ThemedWindow ...&#x0a;    AllowContentOverTitleBar=&quot;True&quot;&gt;&#x0a;&#x0a;    &lt;DockPanel&gt;&#x0a;        &lt;nav:NavigationMenu DockPanel.Dock=&quot;Left&quot; ... /&gt;&#x0a;&#x0a;        &lt;!-- The page drops below the bar, the menu stays full height --&gt;&#x0a;        &lt;ContentControl&#x0a;            Margin=&quot;{StaticResource {x:Static joufflu:Dimensions.TitleBarHeightOffset}}&quot;&#x0a;            Content=&quot;{Binding Navigator.CurrentPage}&quot; /&gt;&#x0a;    &lt;/DockPanel&gt;&#x0a;&lt;/controls:ThemedWindow&gt;"
                Description="Set AllowContentOverTitleBar to draw content over the title bar instead of below it, so a full height side panel reaches the top of the window. Layers, bottom to top: the bar and its drag area, the content, then the title, TitleBarContent and caption buttons, which content never covers. To keep the window grabbable, leave the containers around the page without a Background (null, not Transparent). The page itself is not laid out for you: reserve a gap with the shared Dimensions.TitleBarHeightOffset. NavigationMenu keeps its header strip draggable.">
                <TextBlock
                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                    Text="This gallery uses it: the side menu reaches the very top of the window, while this page is offset below the title bar."
                    TextWrapping="Wrap" />
            </c:CodeExample>

            <c:CodeExample
                Title="OverlayContainer and ToastContainer"
                Code="&lt;feedback:ToastContainer Toasts=&quot;{Binding Toasts}&quot;&gt;&#x0a;    &lt;nav:OverlayContainer Overlays=&quot;{Binding Overlays}&quot;&gt;&#x0a;        &lt;DockPanel&gt;&#x0a;            &lt;nav:NavigationMenu DockPanel.Dock=&quot;Left&quot; Navigator=&quot;{Binding Navigator}&quot; /&gt;&#x0a;            &lt;ContentControl Content=&quot;{Binding Navigator.CurrentPage}&quot; /&gt;&#x0a;        &lt;/DockPanel&gt;&#x0a;    &lt;/nav:OverlayContainer&gt;&#x0a;&lt;/feedback:ToastContainer&gt;"
                Description="Each container wraps the whole app and layers one thing above it: OverlayContainer (Joufflu.Navigation) the modal overlays, ToastContainer (Joufflu.Feedback) the toasts. Wrapping everything is what lets a full screen overlay cover the side menu too; nesting the overlays inside the toasts keeps the toasts on top. The current page needs no dedicated container: bind a ContentControl to the shared Navigator.">
                <TextBlock Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="This whole window is wrapped in both containers; the right-hand area is a ContentControl bound to the navigator." />
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
