<UserControl
    x:Class="Joufflu.Samples.Views.Themes.ThemeCustomizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Themes"
    d:DataContext="{d:DesignInstance Type=vm:ThemeCustomizerViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  One editable colour row: swatch/hex editor + label  -->
        <DataTemplate x:Key="ColorRowTemplate" DataType="{x:Type vm:ThemeColorEntry}">
            <Grid Margin="0,3" toolkit:Spacing.Gap="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <inputs:ColorPicker Grid.Column="0" Color="{Binding Color, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!--  One colour group: a card with its title and a row per colour  -->
        <DataTemplate x:Key="ColorGroupTemplate" DataType="{x:Type vm:ThemeColorGroup}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        toolkit:Sizing.Size="lg"
                        FontWeight="SemiBold"
                        Text="{Binding Header}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemTemplate="{StaticResource ColorRowTemplate}" ItemsSource="{Binding Colors}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  One editable dimension row: label + slider + value  -->
        <DataTemplate x:Key="DimensionRowTemplate" DataType="{x:Type vm:ThemeDimensionEntry}">
            <Grid Margin="0,3" toolkit:Spacing.Gap="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding Label}" />
                <Slider
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding Maximum}"
                    Minimum="{Binding Minimum}"
                    TickFrequency="1"
                    Value="{Binding Value, Mode=TwoWay}" />
                <Border
                    Grid.Column="2"
                    MinWidth="32"
                    VerticalAlignment="Center">
                    <StackPanel
                        HorizontalAlignment="Right"
                        toolkit:Spacing.Gap="4,0"
                        Orientation="Horizontal">
                        <TextBlock Text="{Binding Value, StringFormat=0}" />
                        <TextBlock Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}" Text="{Binding Unit, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!--  One size family: a base slider (two for paddings) + the value derived for each size  -->
        <DataTemplate x:Key="ScaleRowTemplate" DataType="{x:Type vm:ThemeScaleEntry}">
            <Border Style="{StaticResource Card}">
                <StackPanel Margin="0,3" toolkit:Spacing.Gap="0,6">
                    <TextBlock
                        toolkit:Sizing.Size="lg"
                        FontWeight="SemiBold"
                        Text="{Binding Label}"
                        TextWrapping="Wrap" />
                    <!--  Base value(s), the sliders every size is derived from  -->
                    <Grid toolkit:Spacing.Gap="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{Binding BaseLabel, StringFormat=Base ({0})}" />
                        <StackPanel Grid.Column="1" toolkit:Spacing.Gap="0,4">
                            <Grid toolkit:Spacing.Gap="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                    Text="{Binding AxisLabel}" />
                                <Slider
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Maximum}"
                                    Minimum="{Binding Minimum}"
                                    TickFrequency="1"
                                    Value="{Binding Base, Mode=TwoWay}" />
                                <Border
                                    Grid.Column="2"
                                    MinWidth="32"
                                    VerticalAlignment="Center">
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        toolkit:Spacing.Gap="4,0"
                                        Orientation="Horizontal">
                                        <TextBlock Text="{Binding Base, StringFormat=0}" />
                                        <TextBlock Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}" Text="{Binding Unit, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ContentControl Visibility="{Binding HasVertical, Converter={StaticResource BoolToVis}}">
                                <Grid toolkit:Spacing.Gap="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                        Text="V" />
                                    <Slider
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True"
                                        Maximum="{Binding Maximum}"
                                        Minimum="{Binding Minimum}"
                                        TickFrequency="1"
                                        Value="{Binding VerticalBase, Mode=TwoWay}" />
                                    <Border
                                        Grid.Column="2"
                                        MinWidth="32"
                                        VerticalAlignment="Center">
                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            toolkit:Spacing.Gap="4,0"
                                            Orientation="Horizontal">
                                            <TextBlock Text="{Binding VerticalBase, StringFormat=0}" />
                                            <TextBlock Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}" Text="{Binding Unit, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ContentControl>
                        </StackPanel>
                    </Grid>

                    <!--  Derived values, one per size  -->
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThemeScaleStep}">
                                <Grid toolkit:Spacing.Gap="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                        Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Display, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                        Text="{Binding Ratio, StringFormat=×{0}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}" toolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <StackPanel toolkit:Spacing.Gap="4" Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsComplete, Mode=TwoWay}">Use complete mode</CheckBox>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                toolkit:Spacing.Gap="4"
                Orientation="Horizontal">
                <ComboBox Width="200" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemePreset}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                <StackPanel
                                    Grid.Column="1"
                                    toolkit:Spacing.Gap="2,0"
                                    Orientation="Horizontal">
                                    <Border
                                        Width="18"
                                        Height="18"
                                        Background="{Binding Primary}"
                                        CornerRadius="2" />
                                    <Border
                                        Width="18"
                                        Height="18"
                                        Background="{Binding Secondary}"
                                        CornerRadius="2" />
                                    <Border
                                        Width="18"
                                        Height="18"
                                        Background="{Binding Accent}"
                                        CornerRadius="2" />
                                    <Border
                                        Width="18"
                                        Height="18"
                                        Background="{Binding Neutral}"
                                        CornerRadius="2" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Command="{Binding ResetCommand}" Style="{StaticResource GhostButton}">Reset</Button>
                <Button Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}">Copy XAML</Button>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}">Save .xaml…</Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel toolkit:Spacing.Gap="4">
                <StackPanel toolkit:Spacing.Gap="4">
                    <!--  Colours  -->
                    <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}">
                        <TextBlock
                            toolkit:Sizing.Size="xl"
                            FontWeight="SemiBold"
                            Text="Colours"
                            TextWrapping="Wrap" />
                        <StackPanel>
                            <!--  The neutrals apart: the surfaces have three colours, every accent two, so the accents share one row height  -->
                            <ItemsControl ItemTemplate="{StaticResource ColorGroupTemplate}" ItemsSource="{Binding NeutralColorGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid toolkit:Spacing.Gap="4" Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemTemplate="{StaticResource ColorGroupTemplate}" ItemsSource="{Binding AccentColorGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid toolkit:Spacing.Gap="4" Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  Categories, complete mode only  -->
                <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}" Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        toolkit:Sizing.Size="xl"
                        FontWeight="SemiBold"
                        Text="Categories"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid toolkit:Spacing.Gap="4" Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThemeCategoryEditor}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Style="{StaticResource Title}"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <fonts:FontIcon
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}"
                                                Text="{x:Static fonts:LucideFontIcons.Info}"
                                                ToolTip="{Binding Description}" />
                                        </Grid>
                                        <ItemsControl ItemTemplate="{StaticResource ColorRowTemplate}" ItemsSource="{Binding Colors}" />
                                        <ItemsControl ItemTemplate="{StaticResource DimensionRowTemplate}" ItemsSource="{Binding Dimensions}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  Dimensions  -->
                <StackPanel toolkit:Spacing.Gap="0,10">
                    <TextBlock
                        toolkit:Sizing.Size="xl"
                        FontWeight="SemiBold"
                        Text="Dimensions"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                        Text="In the complete mode, the shape below is the one of an app's own layout: the controls take the radius, border and padding of their category, and the control padding gives way to them."
                        TextWrapping="Wrap"
                        Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding DimensionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThemeDimensionGroup}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock
                                            toolkit:Sizing.Size="lg"
                                            FontWeight="SemiBold"
                                            Text="{Binding Header}"
                                            TextWrapping="Wrap" />
                                        <ItemsControl ItemTemplate="{StaticResource DimensionRowTemplate}" ItemsSource="{Binding Dimensions}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemTemplate="{StaticResource ScaleRowTemplate}" ItemsSource="{Binding Scales}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid toolkit:Spacing.Gap="4" Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <!--  The control padding is hidden in the complete mode, where each category has its own  -->
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource BoolToVis}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
