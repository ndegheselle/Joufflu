<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataDisplay/ListView.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type local:ExplorerFile}">
        <StackPanel joufflu:Spacing.Gap="4" Orientation="Horizontal">
            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.File}" />
            <TextBlock Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ExplorerFolder}">
        <StackPanel joufflu:Spacing.Gap="4" Orientation="Horizontal">
            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Folder}" />
            <TextBlock Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>

    <Style BasedOn="{StaticResource {x:Type ListView}}" TargetType="{x:Type local:ListExplorer}">
        <Setter Property="View">
            <Setter.Value>
                <GridView>
                    <GridViewColumn Header="Name">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding ModifiedAt}" Header="Modified at" />
                </GridView>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>