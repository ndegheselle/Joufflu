<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:data="clr-namespace:Joufflu.FileExplorer.Data"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls">

    <!--  Merged for the GhostButton style the buttons of the bar are based on.  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Shows the progress bar only while the session is reading something.  -->
    <converters:VisibilityConverter x:Key="ExplorerBusyVisibilityConverter" />

    <Style TargetType="{x:Type local:ExplorerControlBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExplorerControlBar}">
                    <Grid
                        joufflu:Sizing.Size="sm"
                        joufflu:Spacing.Gap="4"
                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel joufflu:Spacing.Gap="2" Orientation="Horizontal">
                            <Button
                                joufflu:Sizing.IsSquare="True"
                                Command="{Binding Session.GoBackCommand}"
                                Style="{StaticResource GhostButton}"
                                ToolTip="Back">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ArrowLeft}" />
                            </Button>
                            <Button
                                joufflu:Sizing.IsSquare="True"
                                Command="{Binding Session.GoForwardCommand}"
                                Style="{StaticResource GhostButton}"
                                ToolTip="Forward">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ArrowRight}" />
                            </Button>
                            <Button
                                joufflu:Sizing.IsSquare="True"
                                Command="{Binding Session.OpenParentCommand}"
                                Style="{StaticResource GhostButton}"
                                ToolTip="Parent folder">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ArrowUp}" />
                            </Button>
                        </StackPanel>

                        <!--  Scrolls rather than wraps, so that the bar keeps the height of a single row.  -->
                        <ScrollViewer
                            x:Name="PART_Breadcrumb"
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Session.CurrentPath}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type data:IExplorerDirectory}">
                                        <StackPanel Orientation="Horizontal">
                                            <fonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="{x:Static fonts:LucideFontIcons.ChevronRight}">
                                                <fonts:FontIcon.Style>
                                                    <Style BasedOn="{StaticResource {x:Type fonts:FontIcon}}" TargetType="{x:Type fonts:FontIcon}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parent}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </fonts:FontIcon.Style>
                                            </fonts:FontIcon>
                                            <Button
                                                Command="{Binding Session.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ExplorerControlBar}}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Name}"
                                                Style="{StaticResource GhostButton}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>


                        <!--  No CommandParameter : a null one refreshes the opened folder.  -->
                        <Button
                            Grid.Column="2"
                            joufflu:Sizing.IsSquare="True"
                            Command="{Binding Session.RefreshCommand}"
                            Style="{StaticResource GhostButton}"
                            ToolTip="Refresh (F5)">
                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.RefreshCw}" />
                        </Button>

                        <!--
                            Reading a directory is asynchronous, so a slow source (a big folder, a server) shows here
                            rather than freezing. Indeterminate : a source reports no progress.
                        -->
                        <ProgressBar
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Height="2"
                            IsIndeterminate="True"
                            Visibility="{Binding Session.IsBusy, Converter={StaticResource ExplorerBusyVisibilityConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
