        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/Base/ExplorerNode.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/Base/Rename/ExplorerRename.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
