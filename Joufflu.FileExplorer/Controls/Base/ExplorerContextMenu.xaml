<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Joufflu.FileExplorer.Controls.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Joufflu.FileExplorer.Data"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Navigation/MenuItem.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="{base:ContextMenuTemplateKey data:FileSystemDirectory}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem
                Command="{Binding Loader.RenameCommand}"
                CommandParameter="{Binding Node}"
                Header="Rename"
                InputGestureText="F2">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Pencil}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Loader.OpenCommand}"
                CommandParameter="{Binding Node}"
                Header="Open">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FolderOpen}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open in explorer">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FolderOpenDot}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Copy" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardCopy}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Cut" InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardX}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Loader.DeleteCommand}"
                CommandParameter="{Binding Node}"
                Header="Delete"
                InputGestureText="Suppr"
                Style="{StaticResource DangerMenuItem}">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>
    <DataTemplate x:Key="{base:ContextMenuTemplateKey data:FileSystemFile}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem
                Command="{Binding Loader.RenameCommand}"
                CommandParameter="{Binding Node}"
                Header="Rename"
                InputGestureText="F2">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Pencil}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Open">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FileSearch}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open with default software">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FileScan}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open in explorer">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FolderOpenDot}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Copy" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardCopy}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Cut" InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardX}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Loader.DeleteCommand}"
                CommandParameter="{Binding Node}"
                Header="Delete"
                InputGestureText="Suppr"
                Style="{StaticResource DangerMenuItem}">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>
    <DataTemplate x:Key="{base:ContextMenuTemplateKey sys:Object, Scope=Multiple}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem Header="Copy" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardCopy}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Cut" InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardX}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Loader.DeleteCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Delete"
                InputGestureText="Suppr"
                Style="{StaticResource DangerMenuItem}">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>
    <DataTemplate x:Key="{base:ContextMenuTemplateKey sys:Object, Scope=None}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem Header="New folder">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FolderPlus}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                CommandParameter="{Binding Nodes}"
                Header="Past"
                InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardPaste}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>
</ResourceDictionary>