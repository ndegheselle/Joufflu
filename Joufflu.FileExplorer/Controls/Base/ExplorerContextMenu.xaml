<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Joufflu.FileExplorer.Controls.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Joufflu.FileExplorer.Data"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Navigation/MenuItem.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Default context menus, looked up by node type and by scope from the most specific type down to object. A
        consumer replaces one by declaring a template keyed on a type of its own in the resources of a control.

        Two things decide how these are keyed :
        - the menus handing a path over to Windows are keyed on the concrete PhysicalFile and PhysicalDirectory. The
          lookup walks base CLASSES first, so a consumer node deriving from either of them inherits its menu, while a
          node that exists nowhere on the disk never matches and simply has no "Show in file explorer".
        - the fallbacks are keyed on the INTERFACES, which the lookup considers after the classes, so that a source
          building nodes of its own still gets a menu.

        An item is enabled by the CanExecute of its command, which is what a source refusing an operation ends up
        disabling : nothing here has to test what the source supports.
    -->

    <!--  A folder of the file system.  -->
    <DataTemplate x:Key="{base:ContextMenuTemplateKey data:PhysicalDirectory}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem
                Command="{Binding Session.OpenCommand}"
                CommandParameter="{Binding Node}"
                Header="Open">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FolderOpen}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.ShowInFileExplorerCommand}"
                CommandParameter="{Binding Node}"
                Header="Show in file explorer">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ExternalLink}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Session.CutCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Cut"
                InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Scissors}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.CopyCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Copy"
                InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Copy}" />
                </MenuItem.Icon>
            </MenuItem>
            <!--  Pastes into the folder the menu was opened on, not into the opened one.  -->
            <MenuItem
                Command="{Binding Session.PasteCommand}"
                CommandParameter="{Binding Directory}"
                Header="Paste"
                InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardPaste}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.CopyPathCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Copy path">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Link}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <!--  Renaming belongs to the control : it owns the editor that produces the new name.  -->
            <MenuItem
                Command="{Binding Owner.BeginRenameCommand}"
                CommandParameter="{Binding Node}"
                Header="Rename"
                InputGestureText="F2">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Pencil}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.DeleteCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Delete"
                InputGestureText="Del"
                Style="{StaticResource DangerMenuItem}">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>

    <!--  A file of the file system.  -->
    <DataTemplate x:Key="{base:ContextMenuTemplateKey data:PhysicalFile}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem
                Command="{Binding Session.OpenWithDefaultApplicationCommand}"
                CommandParameter="{Binding Node}"
                Header="Open">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.AppWindow}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.ShowInFileExplorerCommand}"
                CommandParameter="{Binding Node}"
                Header="Show in file explorer">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ExternalLink}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Session.CutCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Cut"
                InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Scissors}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.CopyCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Copy"
                InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Copy}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.CopyPathCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Copy path">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Link}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Owner.BeginRenameCommand}"
                CommandParameter="{Binding Node}"
                Header="Rename"
                InputGestureText="F2">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Pencil}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.DeleteCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Delete"
                InputGestureText="Del"
                Style="{StaticResource DangerMenuItem}">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>

    <!--  Any other directory : one built by a source of its own, with nothing on the disk behind it.  -->
    <DataTemplate x:Key="{base:ContextMenuTemplateKey data:IExplorerDirectory}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem
                Command="{Binding Session.OpenCommand}"
                CommandParameter="{Binding Node}"
                Header="Open">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FolderOpen}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.PasteCommand}"
                CommandParameter="{Binding Directory}"
                Header="Paste"
                InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardPaste}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Owner.BeginRenameCommand}"
                CommandParameter="{Binding Node}"
                Header="Rename"
                InputGestureText="F2">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Pencil}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.DeleteCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Delete"
                InputGestureText="Del"
                Style="{StaticResource DangerMenuItem}">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>

    <!--  Any other node. Nothing handing a path to Windows : such a node may well have none.  -->
    <DataTemplate x:Key="{base:ContextMenuTemplateKey data:IExplorerNode}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem
                Command="{Binding Owner.BeginRenameCommand}"
                CommandParameter="{Binding Node}"
                Header="Rename"
                InputGestureText="F2">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Pencil}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.DeleteCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Delete"
                InputGestureText="Del"
                Style="{StaticResource DangerMenuItem}">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>

    <!--  Several selected nodes : only what acts on a whole selection.  -->
    <DataTemplate x:Key="{base:ContextMenuTemplateKey data:IExplorerNode, Scope=Multiple}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem
                Command="{Binding Session.CutCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Cut"
                InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Scissors}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.CopyCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Copy"
                InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Copy}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.CopyPathCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Copy paths">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Link}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Session.DeleteCommand}"
                CommandParameter="{Binding Nodes}"
                Header="Delete"
                InputGestureText="Del"
                Style="{StaticResource DangerMenuItem}">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>

    <!--
        The empty space of the control, acting on the opened directory. Keyed on IExplorerDirectory so that it serves
        every source : the lookup starts from the type of that directory and walks down to its interfaces.
    -->
    <DataTemplate x:Key="{base:ContextMenuTemplateKey data:IExplorerDirectory, Scope=Background}">
        <ContextMenu d:DataContext="{d:DesignInstance Type=base:ExplorerMenuContext}">
            <MenuItem
                Command="{Binding Owner.CreateDirectoryCommand}"
                CommandParameter="{Binding Directory}"
                Header="New folder">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.FolderPlus}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Session.PasteCommand}"
                CommandParameter="{Binding Directory}"
                Header="Paste"
                InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ClipboardPaste}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Session.RefreshCommand}"
                CommandParameter="{Binding Directory}"
                Header="Refresh"
                InputGestureText="F5">
                <MenuItem.Icon>
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.RefreshCw}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </DataTemplate>
</ResourceDictionary>
