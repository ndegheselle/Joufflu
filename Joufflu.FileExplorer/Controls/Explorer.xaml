<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/ExplorerControlBar.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/ExplorerList.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/ExplorerTree.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Hides the count of selected nodes while there is no selection, and the error while there is none.  -->
    <converters:VisibilityConverter x:Key="ExplorerSelectionVisibilityConverter" />

    <Style TargetType="{x:Type local:Explorer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Explorer}">
                    <Grid joufflu:Spacing.Gap="4" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <local:ExplorerControlBar x:Name="PART_ControlBar" Session="{Binding Session}" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" MinWidth="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                            </Grid.ColumnDefinitions>

                            <local:ExplorerTree x:Name="PART_Tree" Session="{Binding Session}" />
                            <!--  Transparent : the tree and the list have borders of their own already.  -->
                            <GridSplitter
                                Grid.Column="1"
                                Width="4"
                                Background="Transparent"
                                ResizeBehavior="PreviousAndNext" />
                            <local:ExplorerList
                                x:Name="PART_List"
                                Grid.Column="2"
                                Session="{Binding Session}" />
                        </Grid>

                        <StatusBar Grid.Row="2" FontSize="{DynamicResource {x:Static joufflu:Dimensions.ControlFontSizeSm}}">
                            <StatusBarItem>
                                <TextBlock Text="{Binding Session.Current.Children.Count, StringFormat={}{0} items}" />
                            </StatusBarItem>
                            <StatusBarItem
                                Visibility="{Binding SelectedNodes.Count, ElementName=PART_List, Converter={StaticResource ExplorerSelectionVisibilityConverter}}">
                                <TextBlock Text="{Binding SelectedNodes.Count, ElementName=PART_List, StringFormat={}{0} selected}" />
                            </StatusBarItem>
                            <!--
                                Last item of the docked panel of the status bar, so it takes the remaining width. The
                                message of a failed operation is shown here rather than in a dialog : an explorer whose
                                folder could not be read stays usable, the next successful operation clearing it.
                            -->
                            <StatusBarItem
                                HorizontalContentAlignment="Right"
                                Visibility="{Binding Session.LastError, Converter={StaticResource ExplorerSelectionVisibilityConverter}}">
                                <TextBlock
                                    Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                                    Text="{Binding Session.LastError}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Session.LastError}" />
                            </StatusBarItem>
                        </StatusBar>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
