<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.FileExplorer.Converters"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/Base/ExplorerNode.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ExplorerList}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExplorerList}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <ListView
                            x:Name="PART_ItemsHost"
                            ItemsSource="{Binding ItemsView}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn DisplayMemberBinding="{Binding ModifiedAt}" Header="Modified at" />
                                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size, Converter={x:Static converters:FileSizeConverter.Default}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!--  Placed over the row of the node being renamed. Omitting it simply disables renaming.  -->
                        <Popup
                            x:Name="PART_RenameEditor"
                            AllowsTransparency="True"
                            Placement="Relative"
                            StaysOpen="False">
                            <TextBox x:Name="PART_RenameEditorBox" />
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
