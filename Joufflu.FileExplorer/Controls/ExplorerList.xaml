<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls">
    <DataTemplate DataType="{x:Type local:PhysicalFile}">
        <StackPanel joufflu:Spacing.Gap="4" Orientation="Horizontal">
            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.File}" />
            <TextBlock Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:PhysicalDirectory}">
        <StackPanel joufflu:Spacing.Gap="4" Orientation="Horizontal">
            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Folder}" />
            <TextBlock Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type local:ExplorerList}">
        <Setter Property="DirectoryContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding Loader.OpenCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Open" />
                    <Separator />
                    <MenuItem
                        Command="{Binding Loader.RenameCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Rename" />
                    <MenuItem
                        Command="{Binding Loader.DeleteCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Delete" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="FileContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding Loader.RenameCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Rename" />
                    <MenuItem
                        Command="{Binding Loader.DeleteCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Delete" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="SelectionContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding Loader.DeleteCommand}"
                        CommandParameter="{Binding Nodes}"
                        Header="Delete" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExplorerList}">
                    <ListView
                        x:Name="PART_ListView"
                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        ItemsSource="{Binding Loader.Current.Children}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn DisplayMemberBinding="{Binding ModifiedAt}" Header="Modified at" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>