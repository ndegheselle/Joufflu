<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/Base/ExplorerNodesControl.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ExplorerTree}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExplorerTree}">
                    <TreeView
                        x:Name="PART_ItemsHost"
                        AllowDrop="True"
                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <TreeView.ItemsSource>
                            <!--  The loaded root, keeping only the kinds of node the tree shows.  -->
                            <MultiBinding Converter="{x:Static local:ExplorerChildrenConverter.Default}">
                                <Binding Path="Source.Root" />
                                <Binding Path="VisibleNodes" />
                            </MultiBinding>
                        </TreeView.ItemsSource>
                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="{x:Type TreeViewItem}">
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <!--
                                No DataType : the header presenter has to resolve the implicit template of the node
                                type, which this template would shadow. The same template drives every level, so the
                                converter gives each node its own sorted, filtered view of its children.
                            -->
                            <HierarchicalDataTemplate>
                                <HierarchicalDataTemplate.ItemsSource>
                                    <MultiBinding Converter="{x:Static local:ExplorerChildrenConverter.Default}">
                                        <Binding />
                                        <Binding Path="VisibleNodes" RelativeSource="{RelativeSource AncestorType={x:Type local:ExplorerTree}}" />
                                    </MultiBinding>
                                </HierarchicalDataTemplate.ItemsSource>
                                <!--  Shared visual of a node, turning into its editable name while it is renamed.  -->
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ExplorerNodeTemplate}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragOver" Value="True">
                            <Setter TargetName="PART_ItemsHost" Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
