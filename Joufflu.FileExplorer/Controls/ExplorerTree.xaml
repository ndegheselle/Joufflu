<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/Base/ExplorerNode.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ExplorerTree}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExplorerTree}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                    <TreeView x:Name="PART_ItemsHost">
                        <TreeView.ItemsSource>
                            <!--  The loaded root, keeping only the kinds of node the tree shows.  -->
                            <MultiBinding Converter="{x:Static local:ExplorerChildrenConverter.Default}">
                                <Binding Path="Session.Root" />
                                <Binding Path="VisibleNodes" />
                            </MultiBinding>
                        </TreeView.ItemsSource>
                        <TreeView.ItemTemplate>
                            <!--
                                No DataType : the header presenter has to resolve the implicit template of the node
                                type, which this template would shadow. The same template drives every level, so the
                                converter gives each node its own sorted, filtered view of its children.
                            -->
                            <HierarchicalDataTemplate>
                                <HierarchicalDataTemplate.ItemsSource>
                                    <MultiBinding Converter="{x:Static local:ExplorerChildrenConverter.Default}">
                                        <Binding />
                                        <Binding Path="VisibleNodes" RelativeSource="{RelativeSource AncestorType={x:Type local:ExplorerTree}}" />
                                    </MultiBinding>
                                </HierarchicalDataTemplate.ItemsSource>
                                <ContentPresenter Content="{Binding}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                        <!--  Placed over the item being renamed. Omitting it simply disables renaming.  -->
                        <Popup
                            x:Name="PART_RenameEditor"
                            AllowsTransparency="True"
                            Placement="Relative"
                            StaysOpen="False">
                            <TextBox x:Name="PART_RenameEditorBox" />
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
