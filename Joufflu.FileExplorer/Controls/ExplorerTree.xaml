<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/Base/ExplorerNode.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ExplorerTree}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExplorerTree}">
                    <TreeView
                        x:Name="PART_ItemsHost"
                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        ItemsSource="{Binding Loader.Root, Converter={x:Static local:ExplorerChildrenConverter.Default}}">
                        <TreeView.ItemTemplate>
                            <!--
                                No DataType : the header presenter has to resolve the implicit template of the node
                                type, which this template would shadow. The same template drives every level, so the
                                converter gives each node its own sorted view of its children.
                            -->
                            <HierarchicalDataTemplate ItemsSource="{Binding Converter={x:Static local:ExplorerChildrenConverter.Default}}">
                                <ContentPresenter Content="{Binding}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
