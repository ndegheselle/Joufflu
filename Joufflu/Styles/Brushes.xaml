<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu">

    <!--
        One brush per palette colour, so a theme only defines the colours: Foreground, Base, Surface1, Surface2 and
        Stroke, then a fill and a content colour per accent. Every state is derived from them by a ColorShade, which
        mixes a colour toward the one drawn on top of it (the Foreground for a neutral, the accent's content colour
        for a fill), so the direction is right in a light and in a dark theme without the theme saying so.
        Not merged in Resources.xaml: ThemeManager pairs a fresh copy of this dictionary with every theme it applies,
        because a brush resolves its DynamicResource colour once and never again; a copy shared across themes would
        keep the colours of the first one.
        
        The neutrals follow where a control sits:
        - Base is the page, and what a button is filled with, so on a card it reads as set into it. A button is not
        put directly on the page.
        - Surface1 is the card and what rests on it: inputs, popups, rows.
        - Surface2 is only the contrast inside a control: a table or group header, a card secondary, a track.
        - Stroke is the border. The states: hover and pressed step the fill (10 %, 15 %) and take the strong stroke
        (15 %), focus takes the focus stroke (40 %), disabled is an opacity.
    -->

    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.ForegroundBrush}" Color="{DynamicResource {x:Static joufflu:Colors.ForegroundColor}}" />

    <joufflu:ColorShade
        x:Key="BaseHoverShade"
        Amount="0.08"
        Toward="{DynamicResource {x:Static joufflu:Colors.ForegroundColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.BaseColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.BaseBrush}" Color="{DynamicResource {x:Static joufflu:Colors.BaseColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.BaseHoverBrush}" Color="{Binding Result, Source={StaticResource BaseHoverShade}}" />

    <joufflu:ColorShade
        x:Key="Surface1HoverShade"
        Amount="0.1"
        Toward="{DynamicResource {x:Static joufflu:Colors.ForegroundColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.Surface1Color}}" />
    <joufflu:ColorShade
        x:Key="Surface1PressedShade"
        Amount="0.15"
        Toward="{DynamicResource {x:Static joufflu:Colors.ForegroundColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.Surface1Color}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.Surface1Brush}" Color="{DynamicResource {x:Static joufflu:Colors.Surface1Color}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.Surface1HoverBrush}" Color="{Binding Result, Source={StaticResource Surface1HoverShade}}" />

    <joufflu:ColorShade
        x:Key="Surface2HoverShade"
        Amount="0.1"
        Toward="{DynamicResource {x:Static joufflu:Colors.ForegroundColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.Surface2Color}}" />
    <joufflu:ColorShade
        x:Key="Surface2PressedShade"
        Amount="0.15"
        Toward="{DynamicResource {x:Static joufflu:Colors.ForegroundColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.Surface2Color}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.Surface2Brush}" Color="{DynamicResource {x:Static joufflu:Colors.Surface2Color}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.Surface2HoverBrush}" Color="{Binding Result, Source={StaticResource Surface2HoverShade}}" />

    <joufflu:ColorShade
        x:Key="StrokeStrongShade"
        Amount="0.25"
        Toward="{DynamicResource {x:Static joufflu:Colors.ForegroundColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.StrokeColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.StrokeBrush}" Color="{DynamicResource {x:Static joufflu:Colors.StrokeColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.StrokeStrongBrush}" Color="{Binding Result, Source={StaticResource StrokeStrongShade}}" />

    <joufflu:ColorShade
        x:Key="PrimaryElevatedShade"
        Amount="0.1"
        Toward="{DynamicResource {x:Static joufflu:Colors.PrimaryContentColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.PrimaryColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.PrimaryBrush}" Color="{DynamicResource {x:Static joufflu:Colors.PrimaryColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.PrimaryElevatedBrush}" Color="{Binding Result, Source={StaticResource PrimaryElevatedShade}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.PrimaryContentBrush}" Color="{DynamicResource {x:Static joufflu:Colors.PrimaryContentColor}}" />

    <joufflu:ColorShade
        x:Key="SecondaryElevatedShade"
        Amount="0.1"
        Toward="{DynamicResource {x:Static joufflu:Colors.SecondaryContentColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.SecondaryColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.SecondaryBrush}" Color="{DynamicResource {x:Static joufflu:Colors.SecondaryColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.SecondaryElevatedBrush}" Color="{Binding Result, Source={StaticResource SecondaryElevatedShade}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.SecondaryContentBrush}" Color="{DynamicResource {x:Static joufflu:Colors.SecondaryContentColor}}" />

    <joufflu:ColorShade
        x:Key="SuccessElevatedShade"
        Amount="0.1"
        Toward="{DynamicResource {x:Static joufflu:Colors.SuccessContentColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.SuccessColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.SuccessBrush}" Color="{DynamicResource {x:Static joufflu:Colors.SuccessColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.SuccessElevatedBrush}" Color="{Binding Result, Source={StaticResource SuccessElevatedShade}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.SuccessContentBrush}" Color="{DynamicResource {x:Static joufflu:Colors.SuccessContentColor}}" />

    <joufflu:ColorShade
        x:Key="InfoElevatedShade"
        Amount="0.1"
        Toward="{DynamicResource {x:Static joufflu:Colors.InfoContentColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.InfoColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.InfoBrush}" Color="{DynamicResource {x:Static joufflu:Colors.InfoColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.InfoElevatedBrush}" Color="{Binding Result, Source={StaticResource InfoElevatedShade}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.InfoContentBrush}" Color="{DynamicResource {x:Static joufflu:Colors.InfoContentColor}}" />

    <joufflu:ColorShade
        x:Key="WarningElevatedShade"
        Amount="0.1"
        Toward="{DynamicResource {x:Static joufflu:Colors.WarningContentColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.WarningColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.WarningBrush}" Color="{DynamicResource {x:Static joufflu:Colors.WarningColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.WarningElevatedBrush}" Color="{Binding Result, Source={StaticResource WarningElevatedShade}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.WarningContentBrush}" Color="{DynamicResource {x:Static joufflu:Colors.WarningContentColor}}" />

    <joufflu:ColorShade
        x:Key="DangerElevatedShade"
        Amount="0.1"
        Toward="{DynamicResource {x:Static joufflu:Colors.DangerContentColor}}"
        Color="{DynamicResource {x:Static joufflu:Colors.DangerColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.DangerBrush}" Color="{DynamicResource {x:Static joufflu:Colors.DangerColor}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.DangerElevatedBrush}" Color="{Binding Result, Source={StaticResource DangerElevatedShade}}" />
    <SolidColorBrush x:Key="{x:Static joufflu:Brushes.DangerContentBrush}" Color="{DynamicResource {x:Static joufflu:Colors.DangerContentColor}}" />

    <!--
        Soft tints. The soft background is the semantic hue at low opacity rather than a dedicated
        palette colour, so it is derived automatically for the built-in themes and for any custom
        theme (the Color is a DynamicResource; only the opacity is fixed). "Soft" is the resting
        fill (also used as the selected state of list rows and tree items, and as the outline
        hover); "SoftElevated" is its hover, as XElevated is the hover of X. Secondary is achromatic, so its soft treatment is a
        neutral foreground wash instead of a hue.
        
        Like the brushes above, they are keyed by ComponentResourceKey so any style in the library
        can reach them with DynamicResource instead of a same-file StaticResource.
    -->

    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.PrimarySoftBrush}"
        Opacity="0.14"
        Color="{DynamicResource {x:Static joufflu:Colors.PrimaryColor}}" />
    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.PrimarySoftElevatedBrush}"
        Opacity="0.24"
        Color="{DynamicResource {x:Static joufflu:Colors.PrimaryColor}}" />

    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.SecondarySoftBrush}"
        Opacity="0.08"
        Color="{DynamicResource {x:Static joufflu:Colors.SecondaryColor}}" />
    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.SecondarySoftElevatedBrush}"
        Opacity="0.14"
        Color="{DynamicResource {x:Static joufflu:Colors.SecondaryColor}}" />

    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.SuccessSoftBrush}"
        Opacity="0.14"
        Color="{DynamicResource {x:Static joufflu:Colors.SuccessColor}}" />
    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.SuccessSoftElevatedBrush}"
        Opacity="0.24"
        Color="{DynamicResource {x:Static joufflu:Colors.SuccessColor}}" />

    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.InfoSoftBrush}"
        Opacity="0.14"
        Color="{DynamicResource {x:Static joufflu:Colors.InfoColor}}" />
    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.InfoSoftElevatedBrush}"
        Opacity="0.24"
        Color="{DynamicResource {x:Static joufflu:Colors.InfoColor}}" />

    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.WarningSoftBrush}"
        Opacity="0.14"
        Color="{DynamicResource {x:Static joufflu:Colors.WarningColor}}" />
    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.WarningSoftElevatedBrush}"
        Opacity="0.24"
        Color="{DynamicResource {x:Static joufflu:Colors.WarningColor}}" />

    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.DangerSoftBrush}"
        Opacity="0.14"
        Color="{DynamicResource {x:Static joufflu:Colors.DangerColor}}" />
    <SolidColorBrush
        x:Key="{x:Static joufflu:Brushes.DangerSoftElevatedBrush}"
        Opacity="0.24"
        Color="{DynamicResource {x:Static joufflu:Colors.DangerColor}}" />

</ResourceDictionary>
