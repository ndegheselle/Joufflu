<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters"
    xmlns:joufflu="clr-namespace:Joufflu">

    <converters:MaxCornerRadiusConverter x:Key="MaxCornerRadiusConverter" />

    <Style x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.DisplaySurface2Brush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border
                            x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Tag="{DynamicResource {x:Static joufflu:Dimensions.DisplayRadius}}">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{StaticResource MaxCornerRadiusConverter}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Border.CornerRadius>
                        </Border>

                        <Border
                            x:Name="PART_Indicator"
                            Background="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left"
                            Tag="{DynamicResource {x:Static joufflu:Dimensions.DisplayRadius}}">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{StaticResource MaxCornerRadiusConverter}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Border.CornerRadius>
                        </Border>

                        <!--  Indeterminate sliding indicator  -->
                        <Border
                            x:Name="IndeterminateRoot"
                            ClipToBounds="True"
                            Tag="{DynamicResource {x:Static joufflu:Dimensions.DisplayRadius}}"
                            Visibility="Collapsed">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{StaticResource MaxCornerRadiusConverter}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Border.CornerRadius>
                            <!--
                                The slider is a band of the opacity mask, a quarter of the bar wide. A brush's
                                RelativeTransform is in fractions of the element, so the band crosses the whole bar
                                at any width (a storyboard in a template cannot bind its To to ActualWidth).
                            -->
                            <Rectangle
                                x:Name="IndeterminateRect"
                                Fill="{TemplateBinding Foreground}"
                                Opacity="0.85"
                                RadiusX="{Binding CornerRadius.TopLeft, ElementName=IndeterminateRoot}"
                                RadiusY="{Binding CornerRadius.TopLeft, ElementName=IndeterminateRoot}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-0.25" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset="0" Color="Black" />
                                        <GradientStop Offset="0.25" Color="Black" />
                                        <GradientStop Offset="0.25" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateRoot" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndeterminateRect"
                                            Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                            From="-0.25"
                                            To="1"
                                            Duration="0:0:1.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource {x:Static joufflu:Colors.DisabledOpacity}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
