            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.SuccessInteractionBrush}}" />
            </Trigger>
