<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu">

    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#FFFAFAFA</Color>


    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#0a0a0a</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#171717</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#252525</Color>

    <!--  Primary: white background, zinc-900 content  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#FFFAFAFA</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#FF18181B</Color>

    <!--  Secondary: zinc-800 background, zinc-50 content  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#FF27272A</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#FFFAFAFA</Color>

    <!--  Success: green-500 / green-950 content  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#00d390</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#004c39</Color>

    <!--  Info: blue-500 / blue-950 content  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#FF3B82F6</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#FF172554</Color>

    <!--  Warning: yellow-500 / yellow-950 content  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FFEAB308</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#FF422006</Color>

    <!--  Danger (Destructive): red-900 background, red-200 content  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#ff627d</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#4d0218</Color>

</ResourceDictionary>