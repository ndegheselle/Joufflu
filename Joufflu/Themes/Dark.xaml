<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu">

    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#FFFAFAFA</Color>
    <Color x:Key="{x:Static joufflu:Colors.Foreground100Color}">#a1a1a1</Color>
    <Color x:Key="{x:Static joufflu:Colors.Foreground200Color}">#a1a1a1</Color>

    <Color x:Key="{x:Static joufflu:Colors.BorderColor}">#2b2b2b</Color>
    <Color x:Key="{x:Static joufflu:Colors.Border100Color}">#383838</Color>

    <Color x:Key="{x:Static joufflu:Colors.BackgroundColor}">#0a0a0a</Color>
    <Color x:Key="{x:Static joufflu:Colors.Background100Color}">#171717</Color>
    <Color x:Key="{x:Static joufflu:Colors.Background200Color}">#282828</Color>

    <!--  Primary: white background, zinc-900 content  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#FFFAFAFA</Color>
    <Color x:Key="{x:Static joufflu:Colors.Primary100Color}">#FFE5E5E5</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryContentColor}">#FF18181B</Color>

    <!--  Secondary: zinc-800 background, zinc-50 content  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#FF27272A</Color>
    <Color x:Key="{x:Static joufflu:Colors.Secondary100Color}">#FF3F3F46</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryContentColor}">#FFFAFAFA</Color>

    <!--  Success: green-500 / green-950 content  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#00d390</Color>
    <Color x:Key="{x:Static joufflu:Colors.Success100Color}">#00bd80</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessContentColor}">#004c39</Color>

    <!--  Info: blue-500 / blue-950 content  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#FF3B82F6</Color>
    <Color x:Key="{x:Static joufflu:Colors.Info100Color}">#FF2563EB</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoContentColor}">#FF172554</Color>

    <!--  Warning: yellow-500 / yellow-950 content  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FFEAB308</Color>
    <Color x:Key="{x:Static joufflu:Colors.Warning100Color}">#FFCA8A04</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningContentColor}">#FF422006</Color>

    <!--  Danger (Destructive): red-900 background, red-200 content  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#ff627d</Color>
    <Color x:Key="{x:Static joufflu:Colors.Danger100Color}">#f54a6a</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerContentColor}">#4d0218</Color>

</ResourceDictionary>