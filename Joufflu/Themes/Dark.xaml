<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu">

    <!--  daisyUI's "dark" theme, converted from OKLCH.  -->

    <!--  Foreground  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#ECF9FF</Color>

    <!--  Background  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#1D232A</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#191E24</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#15191E</Color>

    <!--  Primary: white background, zinc-900 content  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#FFFAFAFA</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#FF18181B</Color>

    <!--  Secondary: zinc-800 background, zinc-50 content  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#FF27272A</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#FFFAFAFA</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#00D390</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#004C39</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#00BAFE</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#042E49</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FCB700</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#793205</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FF627D</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#4D0218</Color>

</ResourceDictionary>
