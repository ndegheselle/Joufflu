<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu">

    <!--  daisyUI's "light" theme, converted from OKLCH.  -->

    <!--  Foreground  -->
    <Color x:Key="{x:Static joufflu:Colors.ForegroundColor}">#18181B</Color>

    <!--  Background  -->
    <Color x:Key="{x:Static joufflu:Colors.Base0Color}">#FFFFFF</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base1Color}">#F8F8F8</Color>
    <Color x:Key="{x:Static joufflu:Colors.Base2Color}">#EEEEEE</Color>

    <!--  Primary: zinc-900 background, white content  -->
    <Color x:Key="{x:Static joufflu:Colors.PrimaryColor}">#FF18181B</Color>
    <Color x:Key="{x:Static joufflu:Colors.PrimaryForegroundColor}">#FFFAFAFA</Color>

    <!--  Secondary: zinc-200 background, zinc-800 content  -->
    <Color x:Key="{x:Static joufflu:Colors.SecondaryColor}">#FFE4E4E7</Color>
    <Color x:Key="{x:Static joufflu:Colors.SecondaryForegroundColor}">#FF27272A</Color>

    <!--  Success  -->
    <Color x:Key="{x:Static joufflu:Colors.SuccessColor}">#00D390</Color>
    <Color x:Key="{x:Static joufflu:Colors.SuccessForegroundColor}">#004C39</Color>

    <!--  Info  -->
    <Color x:Key="{x:Static joufflu:Colors.InfoColor}">#00BAFE</Color>
    <Color x:Key="{x:Static joufflu:Colors.InfoForegroundColor}">#042E49</Color>

    <!--  Warning  -->
    <Color x:Key="{x:Static joufflu:Colors.WarningColor}">#FCB700</Color>
    <Color x:Key="{x:Static joufflu:Colors.WarningForegroundColor}">#793205</Color>

    <!--  Danger  -->
    <Color x:Key="{x:Static joufflu:Colors.DangerColor}">#FF627D</Color>
    <Color x:Key="{x:Static joufflu:Colors.DangerForegroundColor}">#4D0218</Color>

</ResourceDictionary>
