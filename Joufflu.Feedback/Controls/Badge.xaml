<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Joufflu.Feedback.Controls"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <!--  ============================ Badge ============================  -->
    <Style TargetType="{x:Type controls:Badge}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeMd}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!--  A compact display at every size (the font size scales the badge)  -->
        <Setter Property="Padding" Value="{DynamicResource {x:Static joufflu:Dimensions.DisplayPaddingSm}}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Badge}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.DisplayRadius}}"
                        SnapsToDevicePixels="True">
                        <!--  A badge reads as a pill, wider than tall: its sides take twice the padding, its top and bottom half  -->
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            toolkit:Derive.Margin="{TemplateBinding Padding}"
                            toolkit:Derive.MarginFactor="2,0.5,2,0.5" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Variant" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryForegroundBrush}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Secondary">
                <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.SecondaryBrush}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.SecondaryForegroundBrush}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Success">
                <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.SuccessBrush}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.SuccessForegroundBrush}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Info">
                <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.InfoForegroundBrush}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.WarningForegroundBrush}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.DangerForegroundBrush}}" />
            </Trigger>

            <Trigger Property="toolkit:Sizing.Size" Value="xs">
                <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeXs}}" />
            </Trigger>
            <Trigger Property="toolkit:Sizing.Size" Value="sm">
                <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeSm}}" />
            </Trigger>
            <Trigger Property="toolkit:Sizing.Size" Value="lg">
                <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeLg}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
