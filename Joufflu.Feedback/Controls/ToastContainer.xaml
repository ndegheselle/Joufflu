<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Feedback.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu.Feedback;component/Controls/Toast.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        The newest toast is first in the collection, so a plain StackPanel puts it closest to a
        top corner. Bottom corners dock the toasts upwards instead, keeping the newest one
        closest to the corner there too.
    -->
    <ItemsPanelTemplate x:Key="ToastStackPanel">
        <StackPanel />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="ToastStackPanelReversed">
        <DockPanel LastChildFill="False" />
    </ItemsPanelTemplate>

    <Style x:Key="ToastStackItemReversed" TargetType="{x:Type ContentPresenter}">
        <Setter Property="DockPanel.Dock" Value="Bottom" />
    </Style>

    <!--  ============================ ToastContainer ============================  -->
    <Style TargetType="{x:Type local:ToastContainer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToastContainer}">
                    <Grid Background="{TemplateBinding Background}">
                        <!--
                            The wrapped application. Padding insets it only, so the toasts
                            stay anchored to the corner of the whole surface.
                        -->
                        <ContentPresenter Margin="{TemplateBinding Padding}" />

                        <!--  Toast stack (always on top)  -->
                        <Border Margin="{StaticResource {x:Static joufflu:Dimensions.TitleBarHeightOffset}}">
                            <ItemsControl
                                x:Name="ToastStack"
                                Margin="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                ItemTemplate="{StaticResource ToastTemplate}"
                                ItemsPanel="{StaticResource ToastStackPanel}"
                                ItemsSource="{Binding Toasts.Toasts, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Position" Value="TopLeft">
                            <Setter TargetName="ToastStack" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                        <Trigger Property="Position" Value="BottomLeft">
                            <Setter TargetName="ToastStack" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="ToastStack" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="ToastStack" Property="ItemsPanel" Value="{StaticResource ToastStackPanelReversed}" />
                            <Setter TargetName="ToastStack" Property="ItemContainerStyle" Value="{StaticResource ToastStackItemReversed}" />
                        </Trigger>
                        <Trigger Property="Position" Value="BottomRight">
                            <Setter TargetName="ToastStack" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="ToastStack" Property="ItemsPanel" Value="{StaticResource ToastStackPanelReversed}" />
                            <Setter TargetName="ToastStack" Property="ItemContainerStyle" Value="{StaticResource ToastStackItemReversed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
