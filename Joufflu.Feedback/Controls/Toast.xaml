<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jeedback="clr-namespace:Joufflu.Feedback"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Feedback.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  ============================ Toast ============================  -->
    <DataTemplate x:Key="ToastTemplate" DataType="{x:Type jeedback:ToastInstance}">
        <Border
            x:Name="Card"
            MinWidth="280"
            MaxWidth="380"
            Margin="0,0,0,4"
            Background="{DynamicResource {x:Static joufflu:Brushes.DisplayBaseBrush}}"
            BorderBrush="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}"
            BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.DisplayThickness}}"
            CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.DisplayRadius}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!--
                    The card does not clip its content: the progress bar is masked by a border rounded like the
                    card's top corners, so it does not poke over them.
                -->
                <Border
                    x:Name="ProgressMask"
                    Background="{DynamicResource {x:Static joufflu:Brushes.DisplayBaseBrush}}"
                    toolkit:Derive.CornerRadius="{x:Static joufflu:Dimensions.DisplayRadius}"
                    toolkit:Derive.CornerRadiusFactor="1,1,0,0" />
                <ProgressBar
                    x:Name="Progress"
                    Height="4"
                    local:ToastProgress.Duration="{Binding Options.Duration}"
                    Foreground="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}"
                    Maximum="100"
                    Minimum="0"
                    Value="100">
                    <ProgressBar.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=ProgressMask}" />
                    </ProgressBar.OpacityMask>
                </ProgressBar>

                <!--  The close button in its own column, so a long message never runs under it  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Margin="{DynamicResource {x:Static joufflu:Dimensions.DisplayPadding}}"
                        toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <fonts:FontIcon
                            x:Name="Icon"
                            VerticalAlignment="Center"
                            toolkit:Sizing.Size="xl"
                            Foreground="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}"
                            Text="{Binding Icon}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="Bold"
                                Text="{Binding Options.Title}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                Text="{Binding Options.Message}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        toolkit:Derive.Margin="{x:Static joufflu:Dimensions.DisplayPaddingSm}"
                        toolkit:Derive.MarginFactor="0,1,1,0"
                        toolkit:Sizing.IsSquare="True"
                        toolkit:Sizing.Size="xs"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource GhostButton}">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.x}" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Options.Type}" Value="Success">
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.SuccessBrush}}" />
                <Setter TargetName="Progress" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.SuccessBrush}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Options.Type}" Value="Warning">
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                <Setter TargetName="Progress" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Options.Type}" Value="Danger">
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                <Setter TargetName="Progress" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
