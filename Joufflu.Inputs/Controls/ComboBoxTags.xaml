<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Inputs.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataInput/TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataInput/ComboBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu.Inputs;component/Controls/ComboBoxSearch.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:MaxCornerRadiusConverter x:Key="MaxCornerRadiusConverter" />
    <converters:HorizontalThicknessConverter x:Key="HorizontalThicknessConverter" />

    <Style
        x:Key="{x:Type local:ComboBoxTags}"
        BasedOn="{StaticResource {x:Type local:ComboBoxSearch}}"
        TargetType="{x:Type local:ComboBoxTags}">
        <Style.Resources>
            <local:DisplayMemberPathConverter x:Key="DisplayMemberPathConverter" />
        </Style.Resources>
        <!--  Grows with its tags: the size sets a minimum height, not a height (see the size triggers below).  -->
        <Setter Property="Height" Value="auto" />
        <Setter Property="MinHeight" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ComboBoxTags}">
                    <Grid>
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Tag="{DynamicResource {x:Static joufflu:Dimensions.InputRadius}}">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{StaticResource MaxCornerRadiusConverter}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </Border.CornerRadius>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel VerticalAlignment="Center">
                                <ItemsControl
                                    x:Name="TagsPresenter"
                                    Margin="2"
                                    ItemsSource="{Binding InternalSelectedItems, RelativeSource={RelativeSource TemplatedParent}}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--  HeightSm tags + 1px tag margin + 2px presenter margin: a row of tags is a bit taller than HeightMd, the control grows with it  -->
                                            <ContentControl Height="{DynamicResource {x:Static joufflu:Dimensions.HeightSm}}">
                                                <Border
                                                    Margin="1"
                                                    Background="{DynamicResource {x:Static joufflu:Brushes.InputSurface2Brush}}"
                                                    Tag="{DynamicResource {x:Static joufflu:Dimensions.InputRadius}}">
                                                    <Border.CornerRadius>
                                                        <MultiBinding Converter="{StaticResource MaxCornerRadiusConverter}">
                                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                        </MultiBinding>
                                                    </Border.CornerRadius>
                                                    <!--  Padded like an xs action, the remove button tighter on its side  -->
                                                    <StackPanel
                                                        toolkit:Derive.Margin="{x:Static joufflu:Dimensions.ActionPaddingXs}"
                                                        toolkit:Derive.MarginFactor="1,0,0.5,0"
                                                        toolkit:Spacing.Gap="3,0"
                                                        Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource DisplayMemberPathConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource AncestorType=local:ComboBoxTags}" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <Button
                                                            Command="{Binding RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=local:ComboBoxTags}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource EmbeddedButton}">
                                                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.x}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Input padding, horizontal only (like ComboBoxSearch), the row height centres it  -->
                                <Grid
                                    x:Name="SearchContainer"
                                    Margin="{TemplateBinding Padding, Converter={StaticResource HorizontalThicknessConverter}}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                                    <TextBox
                                        x:Name="PART_EditableTextBox"
                                        Height="auto"
                                        MinWidth="50"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Background="{TemplateBinding Background}"
                                        Focusable="True"
                                        Foreground="{TemplateBinding Foreground}"
                                        IsReadOnly="{TemplateBinding IsReadOnly}"
                                        Visibility="Hidden">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer
                                                    Name="PART_ContentHost"
                                                    Focusable="False"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    Template="{StaticResource TextBoxScrollViewerTemplate}"
                                                    VerticalScrollBarVisibility="Hidden" />
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>

                                    <TextBlock
                                        x:Name="PlaceholderText"
                                        IsHitTestVisible="False"
                                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                        Text="Search ..."
                                        Visibility="Collapsed" />
                                </Grid>
                            </WrapPanel>

                            <!--  Chevron handle : the tags and the text box take the control surface, so the drop down needs a target of its own  -->
                            <ToggleButton
                                x:Name="ToggleButton"
                                Grid.Column="1"
                                Width="{DynamicResource {x:Static joufflu:Dimensions.HeightEmbedded}}"
                                Height="{DynamicResource {x:Static joufflu:Dimensions.HeightEmbedded}}"
                                VerticalAlignment="Center"
                                toolkit:Derive.Margin="{TemplateBinding Padding}"
                                toolkit:Derive.MarginFactor="0,0,1,0"
                                ClickMode="Press"
                                Focusable="False"
                                Foreground="{TemplateBinding Foreground}"
                                IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Template="{StaticResource ComboBoxChevronToggleButtonTemplate}" />
                        </Grid>

                        <!--  Popup showing items  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Slide">
                            <Grid
                                x:Name="DropDown"
                                MinWidth="{TemplateBinding FrameworkElement.ActualWidth}"
                                MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}"
                                SnapsToDevicePixels="True">
                                <Border
                                    x:Name="DropDownBorder"
                                    Margin="0,1,0,0"
                                    Padding="{DynamicResource {x:Static joufflu:Dimensions.DisplayPaddingSm}}"
                                    Background="{DynamicResource {x:Static joufflu:Brushes.DisplaySurface1Brush}}"
                                    BorderBrush="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}"
                                    BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.DisplayBorderThickness}}"
                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.DisplayCornerRadius}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Show the placeholder only while empty and unfocused (Text is "" initially, null after blur)  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                <Condition Property="Text" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="FrameworkElement.MinHeight" Value="95" />
                        </Trigger>
                        <Trigger Property="IsGrouping" Value="True">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="UIElement.Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!--  The base size triggers set a fixed Height: re-declared here (later triggers win) so the tags can wrap at every size.  -->
            <Trigger Property="toolkit:Sizing.Size" Value="xs">
                <Setter Property="Height" Value="auto" />
                <Setter Property="MinHeight" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightXs}}" />
            </Trigger>
            <Trigger Property="toolkit:Sizing.Size" Value="sm">
                <Setter Property="Height" Value="auto" />
                <Setter Property="MinHeight" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightSm}}" />
            </Trigger>
            <Trigger Property="toolkit:Sizing.Size" Value="lg">
                <Setter Property="Height" Value="auto" />
                <Setter Property="MinHeight" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightLg}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
