<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Inputs.Controls">
    <Style TargetType="{x:Type local:DropdownPopupHost}">
        <!--
            A Popup renders in its own tree, so the Foreground the Window style pushes down by
            property inheritance never reaches the content. Restate the theme default here, otherwise
            a TextBlock in the popup falls back to its own default, black.
        -->
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DropdownPopupHost}">
                    <Border
                        Background="{DynamicResource {x:Static joufflu:Brushes.BackgroundBrush}}"
                        BorderBrush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}"
                        BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}"
                        CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
