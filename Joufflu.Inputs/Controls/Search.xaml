<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Inputs.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataInput/TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:MaxCornerRadiusConverter x:Key="MaxCornerRadiusConverter" />
    <converters:HorizontalThicknessConverter x:Key="HorizontalThicknessConverter" />

    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type local:Search}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Search}">
                    <Border
                        Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Tag="{DynamicResource {x:Static joufflu:Dimensions.InputRadius}}">
                        <Border.CornerRadius>
                            <MultiBinding Converter="{StaticResource MaxCornerRadiusConverter}">
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </Border.CornerRadius>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <fonts:FontIcon
                                x:Name="SearchIcon"
                                HorizontalAlignment="Right"
                                toolkit:Derive.Margin="{x:Static joufflu:Dimensions.InputPaddingMd}"
                                toolkit:Derive.MarginFactor="1,0,0,0"
                                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                Text="{x:Static fonts:LucideFontIcons.Search}" />

                            <!--  Fixed height: only the horizontal padding applies, the text is centred vertically.  -->
                            <TextBlock
                                Name="PlaceholderText"
                                Grid.Column="1"
                                Margin="{TemplateBinding Padding, Converter={StaticResource HorizontalThicknessConverter}}"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                                Text="Search ..."
                                Visibility="Collapsed" />

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Grid.Column="1"
                                Margin="{TemplateBinding Padding, Converter={StaticResource HorizontalThicknessConverter}}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Template="{StaticResource TextBoxScrollViewerTemplate}" />

                            <!--  Clear button, in its own column so a long text never runs under it  -->
                            <Button
                                Name="ClearButton"
                                Grid.Column="2"
                                toolkit:Derive.Margin="{x:Static joufflu:Dimensions.InputPaddingMd}"
                                toolkit:Derive.MarginFactor="0,0,1,0"
                                Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource EmbeddedButton}">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.x}" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Keeps the icon and the clear button flush with the text padding (md is the default set above).  -->
                        <Trigger Property="toolkit:Sizing.Size" Value="xs">
                            <Setter TargetName="SearchIcon" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingXs}" />
                            <Setter TargetName="ClearButton" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingXs}" />
                        </Trigger>
                        <Trigger Property="toolkit:Sizing.Size" Value="sm">
                            <Setter TargetName="SearchIcon" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingSm}" />
                            <Setter TargetName="ClearButton" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingSm}" />
                        </Trigger>
                        <Trigger Property="toolkit:Sizing.Size" Value="lg">
                            <Setter TargetName="SearchIcon" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingLg}" />
                            <Setter TargetName="ClearButton" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingLg}" />
                        </Trigger>

                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="False" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>